<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!--
      The one place Metis's version number is written.

      It used to live only as a default parameter in installer/build-installer.ps1,
      which meant an ordinary `dotnet publish` produced a binary reporting
      1.0.0 — .NET's default when nobody says otherwise. That build then told
      its own user, truthfully as far as it could tell, that every release on
      GitHub was newer than itself, and showed 1.0.0 on the diagnostics page
      beside an update banner offering 3.15.0. The installer still passes
      -p:Version explicitly and that still wins; this is what every other way of
      building Metis now agrees with.
    -->
    <Version>3.15.0</Version>

    <!--
      Start-up cost. A published Metis was paying full just-in-time compilation
      on first use of every path, which lands on the user as a slow first
      question: the capture, the JPEG encoder, the automation session and the
      HTTP stack are all touched for the first time inside that turn.
      ReadyToRun ships precompiled native code for them, and TieredPGO lets the
      hot paths keep improving over a session.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
</Project>

