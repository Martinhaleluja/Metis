<Application x:Class="Lulu.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Lulu Utility Framework / Google Stitch tokens -->
        <Color x:Key="BabyBlue">#78D8FF</Color>
        <Color x:Key="BabyBlueStrong">#4AC7FF</Color>
        <Color x:Key="Ink">#090D12</Color>
        <Color x:Key="Header">#0D131A</Color>
        <Color x:Key="Panel">#10161D</Color>
        <Color x:Key="PanelRaised">#17212B</Color>
        <Color x:Key="PanelHighest">#26303A</Color>
        <Color x:Key="Muted">#9AA9B8</Color>
        <Color x:Key="Border">#263642</Color>
        <Color x:Key="BorderStrong">#354654</Color>
        <Color x:Key="Mint">#75E7B9</Color>
        <Color x:Key="Pink">#FFB9D5</Color>
        <Color x:Key="Warning">#FFAD42</Color>

        <SolidColorBrush x:Key="BabyBlueBrush" Color="{StaticResource BabyBlue}" />
        <SolidColorBrush x:Key="BabyBlueStrongBrush" Color="{StaticResource BabyBlueStrong}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
        <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource Header}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaised}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
        <SolidColorBrush x:Key="MintBrush" Color="{StaticResource Mint}" />
        <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource Pink}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />

        <FontFamily x:Key="UiFont">Libre Franklin, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Libre Franklin, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="#E8EDF2" />
        </Style>

        <Style x:Key="WordmarkText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="Foreground" Value="{StaticResource BabyBlueBrush}" />
        </Style>

        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#F2F5F8" />
        </Style>

        <Style x:Key="MonoLabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource BabyBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BabyBlueBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BabyBlueStrongBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource BabyBlueStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#E8EDF2" />
            <Setter Property="Background" Value="#10161D" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17212B" />
                    <Setter Property="BorderBrush" Value="{StaticResource BabyBlueStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#C7D0D7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="{StaticResource BabyBlueBrush}" />
            <Setter Property="Background" Value="#26303A" />
            <Setter Property="BorderBrush" Value="{StaticResource BabyBlueStrongBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#F5F7F9" />
            <Setter Property="CaretBrush" Value="{StaticResource BabyBlueBrush}" />
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="SelectionBrush" Value="{StaticResource BabyBlueStrongBrush}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="{StaticResource BabyBlueBrush}" />
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#F5F7F9" />
            <Setter Property="Background" Value="#0B1117" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                        <Setter Property="Foreground" Value="#E8EDF2" />
                        <Setter Property="Background" Value="#10161D" />
                        <Setter Property="Padding" Value="10,7" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#26303A" />
                                <Setter Property="Foreground" Value="{StaticResource BabyBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#26303A" />
                                <Setter Property="Foreground" Value="{StaticResource BabyBlueBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EDF2" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource BabyBlueBrush}" />
        </Style>

        <Style x:Key="UtilityCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Resources>
</Application>
