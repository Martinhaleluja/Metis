<Window x:Class="Lulu.App.Windows.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lulu"
        Width="510" Height="590" MinWidth="430" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource InkBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="110" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                            <Path Fill="{StaticResource BabyBlueBrush}"
                                  Data="M34,8 C42,-1 56,-1 64,7 C72,15 72,27 66,35 C72,43 72,55 64,63 C56,71 44,71 35,65 C27,71 15,71 7,63 C-1,55 -1,43 5,35 C-1,27 -1,15 7,7 C15,-1 27,-1 34,8 Z" />
                        </Viewbox>
                        <TextBlock Text="lulu" Style="{StaticResource WordmarkText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙" Style="{StaticResource ChromeButton}" ToolTip="Setup" Click="Setup_OnClick" />
                        <Button Content="×" Style="{StaticResource ChromeButton}" ToolTip="Hide Lulu" Click="Close_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#111820"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource MintBrush}" Margin="0,0,9,0" />
                        <TextBlock x:Name="StatusText" Text="Ready" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#C9D3DA" />
                    </StackPanel>
                    <Button Content="◉  Stop" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Foreground="#B7C0C7" Padding="11,5"
                            Click="Stop_OnClick" />
                </Grid>
            </Border>

            <ListBox x:Name="MessagesList" Grid.Row="2" Margin="16,12" Padding="0"
                     Background="Transparent" BorderThickness="0" Foreground="White"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Border x:Name="MessageCard" Padding="12,9" MaxWidth="390"
                                    HorizontalAlignment="Left" Background="#101820"
                                    BorderBrush="#365064" BorderThickness="1" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="AuthorLabel" Text="{Binding Author}"
                                               FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                               FontSize="11" Foreground="{StaticResource BabyBlueBrush}" />
                                    <TextBlock Text="{Binding Text}" Margin="0,5,0,0" TextWrapping="Wrap"
                                               FontSize="14" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Author}" Value="You">
                                <Setter TargetName="MessageCard" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="MessageCard" Property="Background" Value="#17212B" />
                                <Setter TargetName="MessageCard" Property="BorderBrush" Value="#3A4B58" />
                                <Setter TargetName="AuthorLabel" Property="Foreground" Value="#DCE4E9" />
                                <Setter TargetName="AuthorLabel" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Author}" Value="Problem">
                                <Setter TargetName="MessageCard" Property="BorderBrush" Value="#9A4452" />
                                <Setter TargetName="AuthorLabel" Property="Foreground" Value="#FF9AA8" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Background="#0D131A"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             KeyDown="PromptBox_OnKeyDown" ToolTip="Type a command…" />
                    <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Padding="0"
                            Content="➤" FontSize="18" ToolTip="Send command" Click="Send_OnClick" />
                    <ProgressBar x:Name="VoiceLevel" Grid.ColumnSpan="2" Height="3" Margin="1,0,1,1"
                                 VerticalAlignment="Bottom" Minimum="0" Maximum="1" Value="0"
                                 Visibility="Hidden" Foreground="{StaticResource BabyBlueStrongBrush}"
                                 Background="#182631" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MonoLabelText}"
                               Text="Hold Ctrl+Shift+1 to talk  •  F12 emergency stop" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource MonoLabelText}" Text="Support  Docs" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
