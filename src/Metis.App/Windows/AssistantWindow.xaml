<Window x:Class="Metis.App.Windows.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis"
        Width="520" Height="620" MinWidth="430" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Border x:Name="RootShell" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar. Traffic lights on the left the way macOS does it,
                 with the status line doubling as the window's subtitle. -->
            <Border Grid.Row="0" Background="#FBFBFD" CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FF5F57" Margin="0,0,8,0"
                                 MouseLeftButtonUp="TrafficLightClose_OnMouseUp" Cursor="Hand" />
                        <Ellipse Width="12" Height="12" Fill="#FEBC2E" Margin="0,0,8,0" Opacity="0.55" />
                        <Ellipse Width="12" Height="12" Fill="#28C840" Margin="0,0,16,0" Opacity="0.55" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Metis" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource MintBrush}"
                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="300" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="◼" Style="{StaticResource ChromeButton}" FontSize="11"
                                ToolTip="Stop" Click="Stop_OnClick" />
                        <Button Content="⚙" Style="{StaticResource ChromeButton}" ToolTip="Setup" Click="Setup_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="16,14" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Bubbles carry the speaker through colour and
                                     side, so no author label is needed. The
                                     squared-off corner marks the tail side. -->
                                <Grid Margin="0,3" RenderTransformOrigin="0,1">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="BubbleScale" ScaleX="0.9" ScaleY="0.9" />
                                            <TranslateTransform x:Name="BubbleRise" Y="8" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Border x:Name="MessageBubble" Padding="13,9" MaxWidth="370"
                                            HorizontalAlignment="Left" Background="#E9E9EB"
                                            CornerRadius="18,18,18,4">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="14" LineHeight="19"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BubbleRise"
                                                                 Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <DataTrigger Binding="{Binding Author}" Value="You">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="MessageBubble" Property="CornerRadius" Value="18,18,4,18" />
                                        <Setter TargetName="MessageBubble" Property="TextBlock.Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Author}" Value="Problem">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="#FDE7E9" />
                                        <Setter TargetName="MessageBubble" Property="TextBlock.Foreground" Value="#8C1D24" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Typing indicator: the same three-dot bubble the phone
                         shows, on the left because it is Metis composing. -->
                    <Border x:Name="TypingBubble" Visibility="Collapsed" Margin="0,3"
                            HorizontalAlignment="Left" Background="#E9E9EB"
                            CornerRadius="18,18,18,4" Padding="15,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TypingDot1" Width="8" Height="8" Fill="#8E8E93" Margin="0,0,5,0" />
                            <Ellipse x:Name="TypingDot2" Width="8" Height="8" Fill="#AEAEB2" Margin="0,0,5,0" />
                            <Ellipse x:Name="TypingDot3" Width="8" Height="8" Fill="#AEAEB2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FBFBFD" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- A pill field, so the composer reads as a message box
                             rather than a form input. -->
                        <Border Background="White" CornerRadius="17"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" Padding="14,8"
                                     KeyDown="PromptBox_OnKeyDown" ToolTip="Ask Metis, or tell it what to do" />
                        </Border>
                        <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                                Width="34" Height="34" Padding="0" Content="↑" FontSize="16"
                                ToolTip="Send" Click="Send_OnClick" />
                    </Grid>
                    <ProgressBar x:Name="VoiceLevel" Height="3" Margin="2,8,44,0"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Hidden"
                                 Foreground="{StaticResource AccentBrush}" Background="#ECECEF"
                                 BorderThickness="0" />
                    <TextBlock Margin="4,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="Ctrl+Alt to ask about the screen  ·  Ctrl+Alt+Shift to point  ·  F12 to stop" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
