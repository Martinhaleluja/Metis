<Window x:Class="Metis.App.Windows.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis"
        Width="520" Height="620" MinWidth="430" MinHeight="470"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <!-- Every colour here is a DynamicResource so the window follows a theme
         change while it is open. It previously carried its own light-mode hex
         values, which left the title and bubble text unreadable in dark. -->
    <Border x:Name="RootShell" Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusWindow}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.16" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar. Traffic lights on the left the way macOS does it,
                 with the status line doubling as the window's subtitle. -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="12,12,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- The traffic lights keep their fixed macOS colours in
                             both themes: they are recognised by colour, and they
                             read against a light or a dark bar equally well. -->
                        <Ellipse Width="12" Height="12" Fill="#FF5F57" Margin="0,0,8,0"
                                 MouseLeftButtonUp="TrafficLightClose_OnMouseUp" Cursor="Hand" />
                        <Ellipse Width="12" Height="12" Fill="#FEBC2E" Margin="0,0,8,0" Opacity="0.55" />
                        <Ellipse Width="12" Height="12" Fill="#28C840" Margin="0,0,16,0" Opacity="0.55" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Metis" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse x:Name="StateDot" Width="7" Height="7"
                                         Fill="{DynamicResource MintBrush}"
                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="300" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="◼" Style="{StaticResource ChromeButton}" FontSize="11"
                                ToolTip="Stop" Click="Stop_OnClick" />
                        <Button Content="⚙" Style="{StaticResource ChromeButton}" ToolTip="Setup" Click="Setup_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="16,14" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Bubbles carry the speaker through colour and
                                     side, so no author label is needed. The
                                     squared-off corner marks the tail side. -->
                                <Grid Margin="0,3" RenderTransformOrigin="0,1">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="BubbleScale" ScaleX="0.9" ScaleY="0.9" />
                                            <TranslateTransform x:Name="BubbleRise" Y="8" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <!-- The text colour is set here on the bubble
                                         rather than on the TextBlock inside it.
                                         A local value on the child would beat
                                         inheritance, so the You and Problem
                                         triggers below could never recolour it. -->
                                    <Border x:Name="MessageBubble" Padding="13,9" MaxWidth="370"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource BubbleThemBrush}"
                                            TextBlock.Foreground="{DynamicResource BubbleThemInkBrush}"
                                            CornerRadius="18,18,18,4">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="14" LineHeight="19" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BubbleRise"
                                                                 Storyboard.TargetProperty="Y"
                                                                 To="0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <DataTrigger Binding="{Binding Author}" Value="You">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="MessageBubble" Property="CornerRadius" Value="18,18,4,18" />
                                        <Setter TargetName="MessageBubble" Property="TextBlock.Foreground" Value="{DynamicResource AccentContrastBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Author}" Value="Problem">
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter TargetName="MessageBubble" Property="TextBlock.Foreground" Value="{DynamicResource DangerInkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                <StackPanel>
                    <!-- Chats are separate threads rather than one endless log,
                         so an old conversation stays findable by what it was
                         about. -->
                    <!-- A Grid rather than a horizontal StackPanel: three fixed
                         widths added up to more than the window's own minimum
                         width, so the model picker was clipped off the right
                         edge. Star columns let both pickers shrink with the
                         window instead of overflowing it. -->
                    <Grid Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ChatSelector" MinWidth="120" FontSize="11"
                                  ToolTip="Earlier conversations"
                                  SelectionChanged="ChatSelector_OnSelectionChanged" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,4" FontSize="11"
                                Style="{StaticResource SecondaryButton}" Content="New chat"
                                ToolTip="Start a fresh conversation" Click="NewChat_OnClick" />

                        <!-- Name and tier only, on one line. The summary and the
                             usage count moved to the tooltip so a row stays
                             readable at the window's minimum width. The tier
                             badge stays visible, because a picker that hides
                             which entries are billed bills people by accident. -->
                        <ComboBox x:Name="ModelSelector" Grid.Column="2" MinWidth="120"
                                  Margin="8,0,0,0" FontSize="11"
                                  ToolTip="Choose the model that answers"
                                  SelectionChanged="ModelSelector_OnSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel.ToolTip>
                                        <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding TierBrush}">
                                            <TextBlock Text="{Binding TierLabel}" FontSize="9"
                                                       FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="ModelUsageText" Margin="2,0,0,8" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- A pill field, so the composer reads as a message box
                             rather than a form input. -->
                        <Border Background="{DynamicResource FieldBrush}" CornerRadius="17"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" Padding="14,8"
                                     KeyDown="PromptBox_OnKeyDown" ToolTip="Ask Metis, or tell it what to do" />
                        </Border>
                        <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                                Width="34" Height="34" Padding="0" Content="↑" FontSize="16"
                                ToolTip="Send" Click="Send_OnClick" />
                    </Grid>
                    <ProgressBar x:Name="VoiceLevel" Height="3" Margin="2,8,44,0"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Hidden"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource PanelHighestBrush}"
                                 BorderThickness="0" />
                    <TextBlock Margin="4,8,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               Text="Ctrl+Alt to ask about the screen  ·  Ctrl+Alt+Shift to point  ·  F12 to stop" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
