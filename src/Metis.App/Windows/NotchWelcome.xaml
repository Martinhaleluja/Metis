<UserControl x:Class="Metis.App.Windows.NotchWelcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="640">

    <UserControl.Resources>

        <!-- The two footer buttons. Defined here in the notch token family
             rather than reusing Controls.xaml, whose Button style is drawn for
             the application's light surfaces and reads as a foreign control on
             the notch's dark bubble. -->
        <Style x:Key="WelcomeButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{DynamicResource NotchTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeQuietButton" TargetType="Button"
               BasedOn="{StaticResource WelcomeButton}">
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NotchMutedBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinWidth" Value="70" />
        </Style>

        <Style x:Key="WelcomeHeadline" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NotchTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="WelcomeBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource NotchMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <!-- One of the three ways Metis can answer. A card rather than a radio
             button because the difference between them is a sentence, not a
             word, and a person choosing here has never used the product. -->
        <!-- A Button, not a Border with a mouse handler. These three cards are
             the only decision first run asks anybody to make, so they are the
             last place to use a control that cannot be tabbed to and that a
             screen reader cannot see at all. -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchScrollThumbBrush}" />
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="10" Padding="14,11"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource NotchChipHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NotchTextBrush}" />
        </Style>

        <Style x:Key="ChoiceBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource NotchMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- A question somebody can tap on their first turn, so the first thing
             Metis does is answer rather than wait. -->
        <Style x:Key="StarterChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource NotchTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="14" Padding="13,7"
                                Background="{DynamicResource NotchChipBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource NotchChipHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource NotchChipHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource NotchBubbleBrush}"
            BorderBrush="{DynamicResource NotchScrollThumbBrush}"
            BorderThickness="1" CornerRadius="14" Margin="0,4,0,10" Padding="24,24,24,20">
        <StackPanel>

            <!-- ============================ Arrival ============================
                 No buttons and nothing to read but two sentences. A person who
                 has never seen a notch cannot be handed a form inside one; the
                 first thing they need to learn is where Metis is. -->
            <StackPanel x:Name="ArrivalStep">
                <Grid HorizontalAlignment="Center" Width="120" Height="42" Margin="0,0,0,4">
                    <Border x:Name="ArrivalHalo" Width="96" Height="14" CornerRadius="7"
                            VerticalAlignment="Top" Margin="0,2,0,0"
                            Background="{DynamicResource AccentBrush}" Opacity="0" />
                    <Border Width="72" Height="9" CornerRadius="5" VerticalAlignment="Top"
                            Margin="0,5,0,0" Background="{DynamicResource NotchChromeBrush}" />
                </Grid>
                <TextBlock Style="{StaticResource WelcomeHeadline}"
                           HorizontalAlignment="Center" Text="Metis lives here." />
                <TextBlock Style="{StaticResource WelcomeBody}" TextAlignment="Center"
                           Text="Everything happens in this bar at the top of your screen. Pull it down whenever you want Metis." />
            </StackPanel>

            <!-- ========================== What it does ==========================
                 The promise, and the limit on it, together. This is the only
                 place screen-reading is explained, and it is explained before
                 anything is asked. -->
            <StackPanel x:Name="PromiseStep" Visibility="Collapsed">
                <TextBlock Style="{StaticResource WelcomeHeadline}"
                           Text="Metis teaches. It never takes over." />
                <TextBlock Style="{StaticResource WelcomeBody}"
                           Text="Ask how to do something and Metis shows you — it marks the screen where to look and talks you through it while you do it yourself. It never clicks, types, or opens anything for you, because the point is that you learn how." />
                <TextBlock Style="{StaticResource WelcomeBody}"
                           Text="It reads your screen only when you ask it a question, and only the part it needs. Nothing is recorded and nothing is sent anywhere until you ask." />
            </StackPanel>

            <!-- ========================= How it answers =========================
                 Three cards, one preselected, none of which need anything typed
                 to get going. The old wizard asked for a provider and an API
                 key here, then asked for both again in Setup afterwards. -->
            <StackPanel x:Name="AnswerStep" Visibility="Collapsed">
                <TextBlock Style="{StaticResource WelcomeHeadline}" Text="How Metis answers." />
                <TextBlock Style="{StaticResource WelcomeBody}" Margin="0,8,0,14"
                           Text="You can change this later in Settings." />

                <Button x:Name="ManagedChoice" Style="{StaticResource ChoiceCard}"
                        AutomationProperties.Name="Use the AI that comes with Metis"
                        Click="Managed_OnClick">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource ChoiceTitle}"
                                       Text="Use the AI that comes with Metis" />
                            <TextBlock x:Name="ManagedTick" Text="✓" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <TextBlock Style="{StaticResource ChoiceBody}"
                                   Text="Nothing to set up. Every plan includes some, and Metis tells you where you are." />
                    </StackPanel>
                </Button>

                <Button x:Name="OwnKeyChoice" Style="{StaticResource ChoiceCard}"
                        AutomationProperties.Name="Use my own AI key"
                        Click="OwnKey_OnClick">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource ChoiceTitle}" Text="Use my own AI key" />
                            <Border x:Name="OwnKeyBadge" CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource NotchChipHoverBrush}">
                                <TextBlock Text="PRO" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="OwnKeyBody" Style="{StaticResource ChoiceBody}"
                                   Text="Bring a key from Google, OpenAI, Anthropic or OpenRouter and pay them directly." />
                    </StackPanel>
                </Button>

                <Button x:Name="LocalChoice" Style="{StaticResource ChoiceCard}"
                        AutomationProperties.Name="Run a model on this computer"
                        Click="Local_OnClick">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource ChoiceTitle}"
                                       Text="Run a model on this computer" />
                            <TextBlock x:Name="LocalTick" Text="✓" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Right" Visibility="Collapsed"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <TextBlock Style="{StaticResource ChoiceBody}"
                                   Text="For Ollama, if you already have it. Nothing leaves the machine." />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ============================= Ready =============================
                 One tap to a real answer. The chips are the point of this step:
                 the old wizard ended on "You're set", which is the moment a
                 first-time user is most likely to close everything and never
                 ask a question. -->
            <StackPanel x:Name="ReadyStep" Visibility="Collapsed">
                <TextBlock Style="{StaticResource WelcomeHeadline}" Text="Ask Metis something." />
                <TextBlock Style="{StaticResource WelcomeBody}" Margin="0,8,0,14"
                           Text="Tap one of these and watch what happens, or type your own." />
                <ItemsControl x:Name="StarterChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StarterChip}" Tag="{Binding}"
                                    Content="{Binding}"
                                    AutomationProperties.Name="{Binding}"
                                    Click="Starter_OnClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============================ Footer ============================ -->
            <Grid Margin="0,20,0,0">
                <!-- Four plain Borders rather than an ItemsControl. An
                     ItemsControl hands its data item to UI Automation as the
                     name of each generated container, so a screen reader was
                     reading out "StepDot { Fill = #FF0A7CFF }" four times over.
                     Borders are outside the automation control view entirely,
                     which is right for a decoration — and the panel carries the
                     one sentence that is actually worth announcing. -->
                <StackPanel x:Name="StepDots" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border x:Name="Dot0" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" />
                    <Border x:Name="Dot1" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" />
                    <Border x:Name="Dot2" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" />
                    <Border x:Name="Dot3" Width="6" Height="6" CornerRadius="3" Margin="0,0,5,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Back_OnClick"
                            Style="{StaticResource WelcomeQuietButton}" />
                    <Button x:Name="NextButton" Content="Continue" Click="Next_OnClick"
                            Style="{StaticResource WelcomeButton}" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
