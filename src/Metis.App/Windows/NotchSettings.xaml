                                    <TextBlock Text="Remove Stored Key" FontSize="10.5" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OpenAiCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="OPENAI CONFIGURATION" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="API Key" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <PasswordBox x:Name="OpenAiApiKeyBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <TextBlock Text="Model" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="OpenAiModelBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource SettingChip}" Margin="0,10,0,0" Tag="OpenAI" MouseLeftButtonUp="RemoveKey_OnClick">
                                    <TextBlock Text="Remove Stored Key" FontSize="10.5" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ClaudeCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ANTHROPIC CLAUDE CONFIGURATION" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="API Key" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <PasswordBox x:Name="ClaudeApiKeyBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <TextBlock Text="Model" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="ClaudeModelBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource SettingChip}" Margin="0,10,0,0" Tag="Claude" MouseLeftButtonUp="RemoveKey_OnClick">
                                    <TextBlock Text="Remove Stored Key" FontSize="10.5" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OpenRouterCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="OPENROUTER CONFIGURATION" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="API Key" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <PasswordBox x:Name="OpenRouterApiKeyBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <TextBlock Text="Model" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="OpenRouterModelBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource SettingChip}" Margin="0,10,0,0" Tag="OpenRouter" MouseLeftButtonUp="RemoveKey_OnClick">
                                    <TextBlock Text="Remove Stored Key" FontSize="10.5" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OllamaCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="OLLAMA LOCAL MODEL" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Endpoint" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="OllamaEndpointBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <TextBlock Text="Model" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="OllamaModelBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================= Voice & Speech ========================= -->
                    <StackPanel x:Name="VoicePage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="VOICE OUTPUT &amp; SPEECH" Style="{StaticResource SettingLabel}" />
                                <CheckBox x:Name="SpeechEnabledCheck" Margin="0,10,0,0"
                                          Content="Speak answers out loud"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <CheckBox x:Name="SpeakErrorsCheck" Margin="0,8,0,12"
                                          Content="Speak error notifications aloud"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />

                                <TextBlock Text="Voice Persona" Style="{StaticResource SettingLabel}" Margin="0,6,0,4" />
                                <ComboBox x:Name="GeminiVoiceBox" Height="30" Margin="0,4,0,8">
                                    <ComboBoxItem Content="Kore — Soothing &amp; balanced (Recommended)" Tag="Kore" />
                                    <ComboBoxItem Content="Puck — Energetic &amp; animated" Tag="Puck" />
                                    <ComboBoxItem Content="Charon — Deep &amp; calm" Tag="Charon" />
                                    <ComboBoxItem Content="Fenrir — Strong &amp; confident" Tag="Fenrir" />
                                    <ComboBoxItem Content="Aoede — Warm &amp; expressive" Tag="Aoede" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border x:Name="PreviewVoiceChip" Style="{StaticResource SettingChip}"
                                            MouseLeftButtonUp="PreviewVoice_OnClick">
                                        <TextBlock Text="Preview Voice 🔊" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <TextBlock x:Name="VoicePreviewStatus" Style="{StaticResource SettingBody}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Dictation, which had no controls here at all.
                             Push-to-talk sends its recording straight to the AI
                             provider, so it works with no setup. Continuous
                             listening cannot: it has to turn audio into text
                             locally to check for the wake word before any turn
                             starts, and "Native" has no implementation that
                             does that. The only place to choose otherwise was
                             PreferencesWindow, which was built and never shown,
                             so every user was stuck on Native and continuous
                             listening simply failed for all of them. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="DICTATION &amp; SPEECH TO TEXT" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,6,0,8"
                                           Text="How Metis turns your voice into text. Push-to-talk works on any setting; continuous listening needs AssemblyAI or Whisper." />
                                <ComboBox x:Name="SpeechToTextProviderBox" Height="30"
                                          SelectionChanged="SpeechToTextProviderBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Native" />
                                    <ComboBoxItem Content="AssemblyAI" />
                                    <ComboBoxItem Content="Whisper.cpp" />
                                </ComboBox>

                                <StackPanel x:Name="NativeSttPanel" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource SettingBody}"
                                               Text="Your recording goes straight to your AI provider, which transcribes it while it answers. Nothing to set up, but continuous listening is unavailable." />
                                </StackPanel>

                                <StackPanel x:Name="AssemblyAiPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="API Key" Style="{StaticResource SettingBody}" Margin="0,0,0,3" />
                                    <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <PasswordBox x:Name="AssemblyAiApiKeyBox" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Model" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                    <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBox x:Name="AssemblyAiModelBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource SettingChip}" Margin="0,10,0,0" Tag="AssemblyAI" MouseLeftButtonUp="RemoveKey_OnClick">
                                        <TextBlock Text="Remove Stored Key" FontSize="10.5" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="WhisperPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource SettingBody}" Margin="0,0,0,6"
                                               Text="Runs on this computer, so nothing leaves it. Metis does not ship whisper.cpp — point these at your own copy." />
                                    <TextBlock Text="whisper-cli.exe" Style="{StaticResource SettingBody}" Margin="0,0,0,3" />
                                    <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBox x:Name="WhisperCppExecutablePathBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Model file (.bin)" Style="{StaticResource SettingBody}" Margin="0,8,0,3" />
                                    <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <TextBox x:Name="WhisperCppModelPathBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- "Is dictation working?" should be answerable
                                     without guessing. This records a few seconds
                                     and shows what came back. -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border x:Name="TestDictationChip" Style="{StaticResource SettingChip}"
                                            MouseLeftButtonUp="TestDictation_OnClick">
                                        <TextBlock Text="Test dictation 🎤" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DictationStatus" Style="{StaticResource SettingBody}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="MICROPHONE &amp; INPUT" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,6,0,8"
                                           Text="Select your input microphone for voice commands and hands-free questions." />
                                <ComboBox x:Name="MicrophoneBox" Height="30" Margin="0,0,0,8" />
                                <TextBlock x:Name="MicrophoneStatus" Style="{StaticResource SettingBody}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================== General ============================ -->
                    <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="WHAT METIS CALLS YOU" Style="{StaticResource SettingLabel}" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                                    <TextBox x:Name="UserNameBox" Background="Transparent" BorderThickness="0" FontSize="12.5"
                                             Foreground="{DynamicResource NotchTextBrush}" CaretBrush="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="APPEARANCE" Style="{StaticResource SettingLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border x:Name="ThemeSystemChip" Style="{StaticResource SettingChip}" Tag="System" MouseLeftButtonUp="Theme_OnClick">
                                        <TextBlock Text="Match Windows" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <Border x:Name="ThemeLightChip" Style="{StaticResource SettingChip}" Margin="8,0,0,0" Tag="Light" MouseLeftButtonUp="Theme_OnClick">
                                        <TextBlock Text="Light" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <Border x:Name="ThemeDarkChip" Style="{StaticResource SettingChip}" Margin="8,0,0,0" Tag="Dark" MouseLeftButtonUp="Theme_OnClick">
                                        <TextBlock Text="Dark" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Start Metis when I sign in"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <CheckBox x:Name="ReduceMotionCheck" Content="Reduce motion" Margin="0,12,0,0"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <TextBlock Text="Turns off animations for maximum performance."
                                           Style="{StaticResource SettingBody}" Margin="26,3,0,0" />
                                <CheckBox x:Name="SoundsCheck" Content="Play sound effects" Margin="0,12,0,0"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================== Companion ========================== -->
                    <StackPanel x:Name="CompanionPage" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: When it appears + Character -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="WHEN IT APPEARS" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Style="{StaticResource SettingBody}" Margin="0,8,0,0"
                                                   Text="Metis's companion arrives when there is something to show you and leaves afterwards. Turn this on if you would rather it stayed." />
                                        <CheckBox x:Name="CompanionAlwaysCheck" Margin="0,10,0,0"
                                                  Content="Keep the companion on screen all the time"
                                                  Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="CHARACTER" Style="{StaticResource SettingLabel}" />
                                        <ItemsControl x:Name="CompanionCharacters" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ShapeButton}" Tag="{Binding Name}"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            AutomationProperties.HelpText="{Binding Description}"
                                                            Click="CompanionCharacter_OnClick">
                                                        <Path Data="{Binding Figure}" Stretch="Uniform"
                                                              Width="28" Height="28"
                                                              Fill="{DynamicResource NotchTextBrush}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="CompanionCharacterName" Style="{StaticResource SettingBody}"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Column: Colour + Size + Distance -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="COLOUR" Style="{StaticResource SettingLabel}" />
                                        <ItemsControl x:Name="CompanionColours" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SwatchButton}" Tag="{Binding Name}"
                                                            Background="{Binding Fill}" AutomationProperties.Name="{Binding Name}"
                                                            Click="CompanionColour_OnClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="CompanionColourName" Style="{StaticResource SettingBody}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="SIZE &amp; DISTANCE" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="SIZE" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotchMutedBrush}" Margin="0,8,0,0" />
                                        <Slider x:Name="CompanionSizeSlider" Minimum="32" Maximum="112"
                                                TickFrequency="8" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        <TextBlock x:Name="CompanionSizeLabel" Style="{StaticResource SettingBody}" Margin="0,2,0,0" />

                                        <TextBlock Text="HOW CLOSE IT FOLLOWS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotchMutedBrush}" Margin="0,10,0,0" />
                                        <Slider x:Name="CursorDistanceSlider" Minimum="0" Maximum="120"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        <TextBlock x:Name="CursorDistanceLabel" Style="{StaticResource SettingBody}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- =========================== Privacy =========================== -->
                    <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="SCREEN ACCESS &amp; VISUAL GUIDANCE" Style="{StaticResource SettingLabel}" />
                                <CheckBox x:Name="CaptureScreenCheck" Margin="0,10,0,0"
                                          Content="Let Metis inspect the screen when I ask questions"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <CheckBox x:Name="VisualGuidanceCheck" Margin="0,8,0,0"
                                          Content="Draw helpful arrows and guidance highlights over windows"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="WHAT METIS NEVER SEES" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,8,0,0"
                                           Text="Banking apps and password managers black themselves out already. Name any other window titles here to keep them private." />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                    <TextBox x:Name="ExcludedAppsBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                             MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                             Foreground="{DynamicResource NotchTextBrush}" CaretBrush="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,6,0,0" Text="One program name per line." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="MEMORY &amp; CONVERSATIONS" Style="{StaticResource SettingLabel}" />
                                <CheckBox x:Name="MemoryEnabledCheck" Margin="0,10,0,0"
                                          Content="Remember past tasks and context"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <CheckBox x:Name="ChatMemoryCheck" Margin="0,8,0,12"
                                          Content="Keep conversations between restarts"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SettingChip}" MouseLeftButtonUp="ClearMemory_OnClick">
                                        <TextBlock Text="Clear Memory" FontSize="11" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource SettingChip}" Margin="8,0,0,0" MouseLeftButtonUp="ClearHistory_OnClick">
                                        <TextBlock Text="Clear Chat History" FontSize="11" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PrivacyStatus" Style="{StaticResource SettingBody}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================ Agents ============================ -->
                    <StackPanel x:Name="AgentsPage" Visibility="Collapsed">
                        <!-- How many agent messages this plan includes.
                             Every plan has agents now, so this is an allowance
                             note rather than a locked banner. Its wording comes
                             from PlanCatalogue at runtime: the version that was
                             here spelled out "Plus and Pro plans" and "Switch to
                             Plus Plan ($12/mo)" in the markup, and went on
                             saying it for months after Plus stopped existing. -->
                        <Border x:Name="AgentsAllowanceCard" Style="{StaticResource SettingCard}"
                                Background="{DynamicResource NotchAccentBedBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <StackPanel>
                                <TextBlock x:Name="AgentsAllowanceLabel" Style="{StaticResource SettingLabel}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="AgentsAllowanceBody" Style="{StaticResource SettingBody}"
                                           Margin="0,6,0,10" />
                                <Border x:Name="AgentsUpgradeChip" Style="{StaticResource SettingChip}"
                                        Background="{DynamicResource AccentBrush}"
                                        BorderThickness="0" MouseLeftButtonUp="UpgradePlan_OnClick">
                                    <TextBlock x:Name="AgentsUpgradeLabel" FontSize="11"
                                               FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="AgentsConfigPanel">
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="BEFORE IT DOES SOMETHING RISKY" Style="{StaticResource SettingLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border x:Name="AskApprovalChip" Style="{StaticResource SettingChip}" Tag="AskApproval" MouseLeftButtonUp="Autonomy_OnClick">
                                            <TextBlock Text="Ask me first" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                        </Border>
                                        <Border x:Name="AutonomousChip" Style="{StaticResource SettingChip}" Margin="8,0,0,0" Tag="Autonomous" MouseLeftButtonUp="Autonomy_OnClick">
                                            <TextBlock Text="Just get on with it" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AutonomyNote" Style="{StaticResource SettingBody}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="HOW LONG ONE MAY RUN" Style="{StaticResource SettingLabel}" />
                                    <Slider x:Name="AgentTurnsSlider" Minimum="5" Maximum="80"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10,0,0" />
                                    <TextBlock x:Name="AgentTurnsLabel" Style="{StaticResource SettingBody}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SettingLabel}" />
                                    <CheckBox x:Name="AgentNotificationsCheck" Margin="0,10,0,0"
                                              Content="Show Windows notifications when tasks complete"
                                              Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================ Skills ============================ -->
                    <StackPanel x:Name="SkillsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="CUSTOM SKILLS &amp; INSTRUCTIONS" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,6,0,10"
                                           Text="Teach Metis about your custom software, command shortcuts, and project workflows using markdown files." />
                                <CheckBox x:Name="UserSkillsCheck" Content="Enable custom skill notes"
                                          Foreground="{DynamicResource NotchTextBrush}" FontSize="12" />
                                <TextBlock Text="Skills folder directory" Style="{StaticResource SettingBody}" Margin="0,10,0,3" />
                                <Border Background="{DynamicResource NotchFieldBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <TextBox x:Name="SkillsFolderBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource SettingChip}" Margin="0,10,0,0" MouseLeftButtonUp="OpenSkillsFolder_OnClick">
                                    <TextBlock Text="Open Skills Folder 📁" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="SYSTEM AUTOMATION TOOLS" Style="{StaticResource SettingLabel}" />
                                <TextBlock x:Name="SystemToolsSummary" Style="{StaticResource SettingBody}" Margin="0,6,0,0"
                                           Text="System terminal execution and advanced machine diagnostics are enabled on your plan." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =========================== Updates =========================== -->
                    <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="THIS COPY OF METIS" Style="{StaticResource SettingLabel}" />
                                <TextBlock x:Name="VersionLabel" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{DynamicResource NotchTextBrush}" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource SettingBody}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border x:Name="CheckUpdatesChip" Style="{StaticResource SettingChip}" MouseLeftButtonUp="CheckUpdates_OnClick">
                                        <TextBlock Text="Check for updates" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================= Diagnostics ========================= -->
                    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="SYSTEM DIAGNOSTICS &amp; ENGINE STATE" Style="{StaticResource SettingLabel}" />
                                <ItemsControl x:Name="DiagnosticsList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource NotchMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource NotchTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource SettingChip}" MouseLeftButtonUp="RefreshDiagnostics_OnClick">
                                        <TextBlock Text="Refresh" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource SettingChip}" Margin="8,0,0,0" MouseLeftButtonUp="OpenLogs_OnClick">
                                        <TextBlock Text="Open log file" FontSize="11.5" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Saving Row -->
            <Grid x:Name="SaveRow" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource NotchFaintBrush}" />
                <Border x:Name="SaveChip" Style="{StaticResource SettingChip}"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                        MouseLeftButtonUp="Save_OnClick">
                    <TextBlock Text="Save Changes" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
