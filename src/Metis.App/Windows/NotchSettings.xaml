<UserControl x:Class="Metis.App.Windows.NotchSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="False">
    <UserControl.Resources>

        <!-- A row in the settings menu. The whole row is the target, not the
             chevron: a 640-wide list where only a 16px glyph responds is a list
             people miss. -->
        <!-- The round chrome buttons. A Button rather than a Border with a
             mouse handler, which is what the rest of the notch does: WPF leaves
             a Border out of the automation control view altogether, so a
             screen reader never sees it however carefully it is named, and it
             has no Enter or Space of its own. The template keeps the look
             identical — a 26px circle with a stroked glyph inside. -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Pill" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A companion colour. A Button so it can be tabbed to and named:
             the colour itself is the content, so a name matters more here than
             it does on a control with words in it. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchChipEdgeBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" CornerRadius="15" BorderThickness="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush"
                                        Value="{DynamicResource NotchTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A companion form. Bigger than a colour swatch because the thing
             being chosen is a shape, and a shape has to be large enough to be
             recognised before it can be picked. -->
        <Style x:Key="ShapeButton" TargetType="Button">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchChipEdgeBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="14" BorderThickness="1.5"
                                Background="{DynamicResource NotchChipBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush"
                                        Value="{DynamicResource NotchTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A plan, as a card. A Button so the keyboard and a screen reader can
             both reach it; the template keeps the card look. -->
        <Style x:Key="PlanRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="12" Padding="14,14"
                                BorderThickness="1.5"
                                MinHeight="136"
                                Background="{DynamicResource NotchFieldBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource NotchChipHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NotchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NotchFaintBrush}" />
        </Style>

        <Style x:Key="SettingBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource NotchMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchChipEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchChipHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SwatchChip" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchChipEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchChipHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Rail" Background="{DynamicResource NotchScrollThumbBrush}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource NotchScrollThumbHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingScroller" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}" />
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource SettingScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Style="{StaticResource ChromeButton}"
                        Visibility="Collapsed" Margin="0,0,10,0"
                        AutomationProperties.Name="Back to settings"
                        Click="Back_OnClick">
                    <Path Data="M 10,4 L 6,8 L 10,12"
                          Stroke="{DynamicResource NotchChromeBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Breadcrumb" Text="Settings" FontSize="10"
                               Foreground="{DynamicResource NotchFaintBrush}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="PageTitle" Text="Settings" FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource NotchTextBrush}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource ChromeButton}"
                        AutomationProperties.Name="Close settings"
                        Click="Close_OnClick">
                    <Path Data="M 5,5 L 11,11 M 11,5 L 5,11"
                          Stroke="{DynamicResource NotchChromeBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource NotchHairlineBrush}" Margin="0,0,0,12" />

            <!-- Content host, deliberately NOT a ScrollViewer.
                 It was one, with MaxHeight="520" on it: the last surviving copy
                 of the hard-coded 520 that NotchGeometry was written to remove.
                 It capped every settings page at 520 points no matter how tall
                 the monitor was, and because it also reported 520 as its desired
                 height, the shell's own "measure again in the space available"
                 logic could never see that there was more to show.

                 It also nested a second scroller inside PageScroll, which the
                 comment on that element forbids in as many words: two
                 scrollbars down the same edge, the inner one capturing the
                 wheel. The shell scrolls; a page does not. -->
            <Grid>
                <StackPanel>
                    <!-- ============================= Menu ============================= -->
                    <StackPanel x:Name="MenuPage">
                        <ItemsControl x:Name="MenuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MenuRow}" Tag="{Binding Key}"
                                            Focusable="True"
                                            KeyDown="MenuRow_OnKey"
                                            AutomationProperties.Name="{Binding Title}"
                                            AutomationProperties.HelpText="{Binding Summary}"
                                            MouseLeftButtonUp="MenuRow_OnClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NotchTextBrush}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                                           Visibility="{Binding SummaryVisibility}"
                                                           Margin="0,1,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource NotchMutedBrush}" />
                                            </StackPanel>
                                            <Path Grid.Column="1" Data="M 6,4 L 10,8 L 6,12"
                                                  Stroke="{DynamicResource NotchFaintBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="10,0,4,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- =========================== Account ============================ -->
                    <StackPanel x:Name="AccountPage" Visibility="Collapsed">
                        <!-- Top Row: Profile Card on Left, Monthly Usage Meters on Right -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>

                            <!-- Profile Header -->
                            <Border Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Border x:Name="AvatarCircle" Width="52" Height="52" CornerRadius="26"
                                                Background="{DynamicResource NotchAccentBedBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                                Cursor="Hand" ToolTip="Click to choose your avatar"
                                                MouseLeftButtonUp="Avatar_OnClick">
                                            <TextBlock x:Name="AvatarEmoji" Text="🦊" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="AccountNameBox" FontSize="15" FontWeight="Bold"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="0" MaxLength="60"
                                                 Foreground="{DynamicResource NotchTextBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 AutomationProperties.Name="Your name"
                                                 ToolTip="Click to change what Metis calls you"
                                                 KeyDown="AccountName_OnKeyDown"
                                                 LostFocus="AccountName_OnLostFocus" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="AccountEmail" Text="local.tester@metis.internal" FontSize="11.5"
                                                       Foreground="{DynamicResource NotchMutedBrush}" VerticalAlignment="Center" />
                                            <Border x:Name="VerifiedBadge" Background="{DynamicResource NotchAccentBedBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="✓ Verified" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Avatar Selection Tray -->
                                        <WrapPanel x:Name="AvatarPickerTray" Margin="0,8,0,0" Visibility="Collapsed">
                                            <Border Style="{StaticResource SwatchChip}" Tag="🦊" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🦊" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🦉" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🦉" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="⚡" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🔮" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🔮" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🚀" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🚀" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🤖" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🤖" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🎨" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🎨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="🐼" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="🐼" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <Border Style="{StaticResource SwatchChip}" Tag="👑" MouseLeftButtonUp="PickAvatar_OnClick"><TextBlock Text="👑" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        </WrapPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border x:Name="SignInChip" Style="{StaticResource SettingChip}" MouseLeftButtonUp="SignIn_OnClick">
                                                <TextBlock Text="Sign in" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                            </Border>
                                            <Border x:Name="SignOutChip" Style="{StaticResource SettingChip}" MouseLeftButtonUp="SignOut_OnClick">
                                                <TextBlock Text="Sign out" FontSize="11" Foreground="{DynamicResource NotchMutedBrush}" />
                                            </Border>
                                            <Border x:Name="ManageWebChip" Style="{StaticResource SettingChip}" Margin="8,0,0,0"
                                                    Background="{DynamicResource NotchChipHoverBrush}" MouseLeftButtonUp="ManagePlan_OnClick">
                                                <TextBlock Text="Manage on Web ↗" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Usage Card -->
                            <Border Grid.Column="1" x:Name="UsageCard" Style="{StaticResource SettingCard}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="THIS MONTH" Style="{StaticResource SettingLabel}" />
                                    <ItemsControl x:Name="UsageList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   Foreground="{DynamicResource NotchTextBrush}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource NotchMutedBrush}" />
                                                    </Grid>
                                                    <Grid Height="5" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource NotchFieldBrush}"
                                                                CornerRadius="2.5" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Used}" />
                                                                <ColumnDefinition Width="{Binding Left}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{Binding FillBrush}" CornerRadius="2.5" />
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="UsageDetail" Style="{StaticResource SettingBody}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ====================== Choosing a plan ======================
                             Three plans in a horizontal 3-column grid, matching v3.15.0 and the web. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="YOUR PLAN" Style="{StaticResource SettingLabel}" />
                                <TextBlock x:Name="PlanSwitcherNote" Style="{StaticResource SettingBody}"
                                           Margin="0,4,0,10" />

                                <ItemsControl x:Name="PlanList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Margin="-4,0,-4,0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PlanRow}" Tag="{Binding Key}"
                                                    BorderBrush="{Binding EdgeBrush}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Click="SelectPlan_OnClick">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Name & Current Plan badge -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource NotchTextBrush}" />
                                                        <Border Background="{DynamicResource NotchAccentBedBrush}"
                                                                CornerRadius="7" Padding="6,1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding CurrentVisibility}">
                                                            <TextBlock Text="YOUR PLAN" FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Price & Cadence -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding Price}" FontSize="19"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource NotchTextBrush}" />
                                                        <TextBlock Text="{Binding Cadence}" FontSize="10" Margin="4,0,0,2"
                                                                   VerticalAlignment="Bottom"
                                                                   Foreground="{DynamicResource NotchFaintBrush}" />
                                                    </StackPanel>

                                                    <!-- Summary -->
                                                    <TextBlock Grid.Row="2" Text="{Binding Summary}" FontSize="10.5"
                                                               TextWrapping="Wrap" LineHeight="15"
                                                               Foreground="{DynamicResource NotchMutedBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Plan Feature Checklist in 2 Columns -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="PLAN CAPABILITIES" Style="{StaticResource SettingLabel}" />
                                <ItemsControl x:Name="FeatureList" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StatusSymbol}" FontSize="11"
                                                           Foreground="{Binding StatusBrush}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                                           Foreground="{DynamicResource NotchTextBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="FeatureNote" Style="{StaticResource SettingBody}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================= Intelligence (AI Models & Keys) ========================= -->
                    <StackPanel x:Name="IntelligencePage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="AI PROVIDER &amp; REASONING" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingBody}" Margin="0,6,0,10"
                                           Text="Choose which AI intelligence engine powers your Metis answers and guidance." />
                                
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AiProviderBox" Height="30" SelectionChanged="AiProviderBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Metis (Managed)" Tag="Metis" />
                                        <ComboBoxItem Content="Google Gemini" Tag="Gemini" />
                                        <ComboBoxItem Content="OpenAI" Tag="OpenAI" />
                                        <ComboBoxItem Content="Anthropic Claude" Tag="Claude" />
                                        <ComboBoxItem Content="OpenRouter" Tag="OpenRouter" />
                                        <ComboBoxItem Content="Ollama (Local)" Tag="Ollama" />
                                        <ComboBoxItem Content="OpenClaw" Tag="OpenClaw" />
                                    </ComboBox>
                                    <Border x:Name="TestProviderChip" Grid.Column="1" Style="{StaticResource SettingChip}"
                                            Margin="8,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="TestProvider_OnClick">
                                        <TextBlock Text="Test Connection" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="AiProviderStatus" Style="{StaticResource SettingBody}" Margin="0,6,0,0" />
