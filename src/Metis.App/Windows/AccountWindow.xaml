<Window x:Class="Metis.App.Windows.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis Account"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" Text="Sign in to Metis" Style="{StaticResource PageTitleText}" />
            <TextBlock x:Name="SubheadingText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       Text="An account is only needed for Pro features and syncing. Metis works without one, using your own API key." />
        </StackPanel>

        <!-- Signed out: the sign in / sign up form. -->
        <StackPanel x:Name="FormPanel" Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Email" FontWeight="SemiBold" />
            <TextBox x:Name="EmailBox" Margin="0,5,0,0" MaxLength="200" />

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,16,0,0" />
            <!-- A PasswordBox rather than a TextBox: it keeps the value out of
                 the automation tree, so nothing reading the screen can lift it. -->
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,0" MaxLength="200" />
            <TextBlock x:Name="PasswordHintText" Margin="0,5,0,0" FontSize="11"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="At least eight characters." Visibility="Collapsed" />

            <Button x:Name="PrimaryButton" Content="Sign in" Margin="0,22,0,0" Height="36"
                    Click="Primary_OnClick" />

            <Button x:Name="SwitchModeButton" Content="Create an account instead" Margin="0,10,0,0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource AccentBrush}" Click="SwitchMode_OnClick" />

            <TextBlock x:Name="StatusText" Margin="0,18,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- Signed in: what the account actually entitles you to. -->
        <StackPanel x:Name="AccountPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
            <Border Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="AccountEmailText" FontWeight="SemiBold" />
                    <TextBlock x:Name="AccountPlanText" Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="AccountEnvironmentText" Margin="0,4,0,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="What this account can do" FontWeight="SemiBold" Margin="0,20,0,0" />
            <ItemsControl x:Name="FeatureList" Margin="0,8,0,0" />

            <Button x:Name="SignOutButton" Content="Sign out" Margin="0,22,0,0" Height="34"
                    Click="SignOut_OnClick" />
        </StackPanel>

        <TextBlock Grid.Row="2" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Metis never stores your password. Signing in saves a revocable token in Windows Credential Manager, encrypted for your user account only." />
    </Grid>
</Window>
