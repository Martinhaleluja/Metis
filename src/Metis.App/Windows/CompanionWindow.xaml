<Window x:Class="Metis.App.Windows.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis companion"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <StackPanel x:Name="RootPanel" Orientation="Horizontal" Margin="10">
        <Grid x:Name="CompanionHost" Width="56" Height="56" VerticalAlignment="Top">
            <Viewbox Stretch="Uniform">
                <Grid Width="72" Height="72">
                    <Path x:Name="CompanionShape"
                          Margin="6"
                          Stretch="Uniform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          RenderTransformOrigin="0.5,0.5"
                          Data="M34,8 C42,-1 56,-1 64,7 C72,15 72,27 66,35 C72,43 72,55 64,63 C56,71 44,71 35,65 C27,71 15,71 7,63 C-1,55 -1,43 5,35 C-1,27 -1,15 7,7 C15,-1 27,-1 34,8 Z">
                        <Path.Fill>
            <SolidColorBrush x:Name="CompanionFill" Color="#CAEEFF" />
                        </Path.Fill>
                        <!-- The flight transforms are separate from the state
                             transforms on purpose. Speaking, thinking, and
                             error all animate CompanionScale and CompanionTilt,
                             and an animated property ignores direct writes, so
                             a flight driving those same transforms would either
                             be swallowed or would cancel the state animation.
                             Kept apart, a companion can swoop across the screen
                             while still visibly talking. -->
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CompanionScale" />
                                <RotateTransform x:Name="CompanionTilt" />
                                <ScaleTransform x:Name="FlightScale" />
                                <RotateTransform x:Name="FlightLean" />
                                <!-- A third pair, for the two reactions that
                                     are neither a state nor a journey: the spin
                                     the companion arrives on, and the bounce it
                                     lands with. They cannot share the flight's
                                     transforms, because those are written
                                     directly on every frame and an animated
                                     property ignores direct writes — a landing
                                     bounce held on FlightScale would freeze the
                                     next flight's swell at its final value. -->
                                <ScaleTransform x:Name="ReactionScale" />
                                <RotateTransform x:Name="ArrivalSpin" />
                                <TranslateTransform x:Name="CompanionShift" />
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Effect>
                            <DropShadowEffect x:Name="CompanionGlow" Color="#56CCFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                        </Path.Effect>
                    </Path>

                    <!-- Status indicators travel together. Each companion form
                         says where its own solid area is, because a hand's is
                         its fist and an arrow's is its head — leaving these at
                         the centre of the box would hang them off a fingertip. -->
                    <Grid x:Name="IndicatorLayer" HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="IndicatorScale" />
                                <TranslateTransform x:Name="IndicatorShift" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid x:Name="WavePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="Wave1" Width="3" Height="9" Margin="1" RadiusX="1.5" Fill="#071018" />
                                <Rectangle x:Name="Wave2" Width="3" Height="17" Margin="1" RadiusX="1.5" Fill="#071018" />
                                <Rectangle x:Name="Wave3" Width="3" Height="12" Margin="1" RadiusX="1.5" Fill="#071018" />
                                <Rectangle x:Name="Wave4" Width="3" Height="20" Margin="1" RadiusX="1.5" Fill="#071018" />
                                <Rectangle x:Name="Wave5" Width="3" Height="10" Margin="1" RadiusX="1.5" Fill="#071018" />
                            </StackPanel>
                        </Grid>
                        <Ellipse x:Name="ThinkingRing" Width="14" Height="14" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="#071018" StrokeThickness="2" StrokeDashArray="1,2">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="ThinkingRotation" CenterX="7" CenterY="7" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- A compact badge in the same language as the on-screen annotation
             labels, in Metis blue. It carries a short answer and no more:
             anything longer belongs in the chat window, not floating over the
             user's work. The companion's own ring shows thinking, so there is
             no loader in here. -->
        <Grid x:Name="SpeechBubble" Visibility="Collapsed" Margin="2,0,0,0"
              VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.25" ScaleY="0.25" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0" Width="8" Height="13" VerticalAlignment="Center"
                  Margin="0,0,-1,0" Stretch="Fill"
                  Data="M8,0 C8,7 5,11 0,13 C5,13 8,11 8,8 Z">
                <Path.Fill>
                    <SolidColorBrush x:Name="BubbleTailFill" Color="#0A7CFF" />
                </Path.Fill>
            </Path>

            <Border Grid.Column="1" MaxWidth="330" CornerRadius="9" Padding="11,7">
                <Border.Background>
                    <SolidColorBrush x:Name="BubbleFill" Color="#0A7CFF" />
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.28" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SpeechText" Foreground="White" FlowDirection="LeftToRight"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5" LineHeight="17"
                               TextWrapping="Wrap" MaxWidth="306" />
                    <TextBlock x:Name="MoreInChatHint" Visibility="Collapsed" Margin="0,3,0,0"
                               FontSize="10" FontWeight="SemiBold" Opacity="0.85"
                               Foreground="White" Text="Full answer in Metis ↑" />
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</Window>
