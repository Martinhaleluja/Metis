<UserControl x:Class="Metis.App.Windows.NotchAgentDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DrawerInk" Color="#F2F2F7" />
        <SolidColorBrush x:Key="DrawerMuted" Color="#8E8E93" />
        <SolidColorBrush x:Key="DrawerFaint" Color="#5A5A61" />
        <SolidColorBrush x:Key="DrawerSurface" Color="#121215" />
        <SolidColorBrush x:Key="DrawerCard" Color="#1C1C21" />
        <SolidColorBrush x:Key="DrawerCardInner" Color="#141418" />
        <SolidColorBrush x:Key="DrawerAccent" Color="#0A7CFF" />
        <SolidColorBrush x:Key="DrawerSuccess" Color="#30D158" />
        <SolidColorBrush x:Key="DrawerWarning" Color="#FF9F0A" />
        <SolidColorBrush x:Key="DrawerDanger" Color="#FF6257" />

        <Style x:Key="DrawerIconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerChipButton" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerScroller" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource DrawerSurface}" Width="540" Margin="0,4,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,10,14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource DrawerAccent}" />
                <TextBlock Text="Autonomous Background Agents" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource DrawerInk}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="NewAgentButton" Style="{StaticResource DrawerChipButton}"
                        Background="{StaticResource DrawerAccent}" Margin="0,0,8,0"
                        ToolTip="Start a background agent"
                        MouseLeftButtonUp="NewAgent_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,4,0" />
                        <TextBlock Text="Spawn Agent" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Border>
                <Border x:Name="CloseButton" Style="{StaticResource DrawerIconButton}"
                        ToolTip="Close Drawer" MouseLeftButtonUp="Close_OnClick">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource DrawerMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tasks List -->
        <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,6">
            <StackPanel>
                <!-- Empty State -->
                <Border x:Name="EmptyState" Background="{StaticResource DrawerCard}" CornerRadius="12"
                        Padding="20,24" Margin="0,4" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="No active background agents" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource DrawerInk}" HorizontalAlignment="Center" />
                        <TextBlock Text="Click '+ Spawn Agent' above, type /spawn followed by what you want done, or just ask Metis in the chat."
                                   FontSize="11" Foreground="{StaticResource DrawerMuted}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0" TextAlignment="Center" MaxWidth="380" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks ItemsControl -->
                <ItemsControl x:Name="TasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource DrawerCard}" CornerRadius="12" Margin="0,0,0,12" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Goal & Status Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Goal}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DrawerInk}" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" CornerRadius="4" Padding="7,2.5" Margin="8,0,0,0"
                                                VerticalAlignment="Top" Background="#26FFFFFF">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Progress & Current Activity -->
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding CurrentActivity}" FontSize="11" Foreground="{StaticResource DrawerMuted}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="390" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ProgressPercentText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DrawerInk}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="5"
                                                     Foreground="{StaticResource DrawerAccent}" Background="#22FFFFFF"
                                                     BorderThickness="0" />
                                    </StackPanel>

                                    <!-- Multi-Step Plan & Execution List (Supports 100+ steps) -->
                                    <Border Grid.Row="2" Background="{StaticResource DrawerCardInner}" CornerRadius="8"
                                            Padding="10,8" Margin="0,10,0,0" Visibility="{Binding StepsVisibility}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📋" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StepsSummaryText}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DrawerInk}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Multi-step execution" FontSize="9.5" Foreground="{StaticResource DrawerFaint}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Scrollable Step List for 100+ steps -->
                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="6" Background="#12FFFFFF">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Step Index -->
                                                                    <Border Grid.Column="0" CornerRadius="4" Background="#26FFFFFF"
                                                                            Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding StepNumberText}" FontSize="9"
                                                                                   FontWeight="Bold" Foreground="{StaticResource DrawerInk}" />
                                                                    </Border>

                                                                    <!-- Step Info -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                                   Foreground="{StaticResource DrawerInk}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding ToolInfo}" FontSize="9.5"
                                                                                   Foreground="{StaticResource DrawerMuted}" Margin="0,1,0,0"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="9.5"
                                                                                   Foreground="{StaticResource DrawerDanger}" Margin="0,1,0,0"
                                                                                   TextWrapping="Wrap" Visibility="{Binding ErrorVisibility}" />
                                                                    </StackPanel>

                                                                    <!-- Verification Status Badge -->
                                                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,2" Margin="6,0,0,0"
                                                                            VerticalAlignment="Top" Background="{Binding StatusBgBrush}">
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold"
                                                                                   Foreground="{Binding StatusBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pending Approval Banner (if applicable) -->
                                    <Border Grid.Row="3" Background="#2E1C0A" BorderBrush="{StaticResource DrawerWarning}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding ApprovalVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Approval Required" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DrawerWarning}" />
                                                <TextBlock Text="{Binding ApprovalReason}" FontSize="10.5" Foreground="{StaticResource DrawerInk}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <!-- What is actually being allowed. Approving without
                                                     seeing the tool and its arguments is not consent. -->
                                                <TextBlock FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource DrawerWarning}">
                                                    <Run Text="{Binding ApprovalTool, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="   " />
                                                    <Run Text="{Binding ApprovalRisk, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ApprovalArguments}" FontSize="10" Margin="0,3,0,0"
                                                           FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="52"
                                                           Foreground="{StaticResource DrawerMuted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Border Style="{StaticResource DrawerChipButton}" Background="{StaticResource DrawerSuccess}"
                                                        Padding="10,0" Height="24" Margin="0,0,6,0" Tag="{Binding Id}"
                                                        MouseLeftButtonUp="ApproveTask_OnClick">
                                                    <TextBlock Text="Approve" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <Border Style="{StaticResource DrawerChipButton}" Background="{StaticResource DrawerDanger}"
                                                        Padding="10,0" Height="24" Tag="{Binding Id}"
                                                        MouseLeftButtonUp="DenyTask_OnClick">
                                                    <TextBlock Text="Deny" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- What the agent actually produced. None of this was
                                         shown anywhere before, so a report an agent wrote could
                                         only be found by going looking on disk. -->
                                    <Border Grid.Row="3" Background="{StaticResource DrawerCardInner}" CornerRadius="8"
                                            Padding="10,8" Margin="0,8,0,0"
                                            Visibility="{Binding ArtifactsVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ArtifactsSummaryText}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="{StaticResource DrawerMuted}" />
                                            <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Cursor="Hand" Padding="0,3"
                                                                Tag="{Binding FilePath}"
                                                                ToolTip="{Binding FilePath}"
                                                                MouseLeftButtonUp="OpenArtifact_OnClick">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                                               Foreground="{StaticResource DrawerAccent}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                                               Foreground="{StaticResource DrawerFaint}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="9.5"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource DrawerFaint}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Controls -->
                                    <Grid Grid.Row="4" Margin="0,10,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Foreground="{StaticResource DrawerFaint}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320">
                                                <Run Text="{Binding TimeAgoText, Mode=OneWay}" />
                                                <Run Text="   " />
                                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="9.5" Foreground="{StaticResource DrawerFaint}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,1,0,0"
                                                       ToolTip="{Binding WorkingDirectory}">
                                                <Run Text="{Binding OriginText, Mode=OneWay}" />
                                                <Run Text="   " />
                                                <Run Text="{Binding WorkingDirectory, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Style="{StaticResource DrawerChipButton}" Background="#260A7CFF" Margin="0,0,6,0" Height="22" Padding="8,0"
                                                    Visibility="{Binding RetryVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="RetryTask_OnClick">
                                                <TextBlock Text="Retry" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DrawerAccent}" />
                                            </Border>
                                            <Border Style="{StaticResource DrawerChipButton}" Margin="0,0,6,0" Height="22" Padding="8,0"
                                                    Visibility="{Binding PauseResumeVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="PauseResume_OnClick">
                                                <TextBlock Text="{Binding PauseResumeLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DrawerInk}" />
                                            </Border>
                                            <Border Style="{StaticResource DrawerChipButton}" Background="#26FF6257" Height="22" Padding="8,0"
                                                    Visibility="{Binding CancelVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="CancelTask_OnClick">
                                                <TextBlock Text="Cancel" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DrawerDanger}" />
                                            </Border>
                                            <!-- Finished tasks piled up forever: this list is also the
                                                 history, and nothing could remove an entry from it. -->
                                            <Border Style="{StaticResource DrawerChipButton}" Height="22" Padding="8,0"
                                                    Visibility="{Binding DismissVisibility}" Tag="{Binding Id}"
                                                    ToolTip="Remove this from the list"
                                                    MouseLeftButtonUp="DismissTask_OnClick">
                                                <TextBlock Text="Clear" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DrawerMuted}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Emergency Stop & Shortcut Reminder -->
        <Grid Grid.Row="2" Margin="16,8,16,6">
            <TextBlock Text="Ask Metis, or type /spawn  ·  Stop All ends every agent immediately" FontSize="10"
                       Foreground="{StaticResource DrawerFaint}" VerticalAlignment="Center" />
            <Border Style="{StaticResource DrawerChipButton}" Background="#26FF6257" HorizontalAlignment="Right"
                    Padding="10,0" Height="24" MouseLeftButtonUp="EmergencyStop_OnClick">
                <TextBlock Text="Stop All Agents" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DrawerDanger}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
