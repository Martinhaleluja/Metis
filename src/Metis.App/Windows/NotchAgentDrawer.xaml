<UserControl x:Class="Metis.App.Windows.NotchAgentDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>

        <Style x:Key="DrawerIconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerChipButton" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource NotchToolBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchScrollThumbBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DrawerScroller" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource NotchSurfaceBrush}" Width="540" Margin="0,4,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,12,14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Metis Helpers &amp; Tasks" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="NewAgentButton" Style="{StaticResource DrawerChipButton}"
                        Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                        ToolTip="Start a background helper task"
                        MouseLeftButtonUp="NewAgent_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,4,0" />
                        <TextBlock Text="Start Helper" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Border>
                <Border x:Name="CloseButton" Style="{StaticResource DrawerIconButton}"
                        ToolTip="Close Drawer" MouseLeftButtonUp="Close_OnClick">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource NotchMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Tasks List -->
        <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,6">
            <StackPanel>
                <!-- Free Tier Gating Banner -->
                <Border x:Name="PlanGateBanner" Background="{DynamicResource NotchAccentBedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PlanGateTitle" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Let Metis research topics, guide you through software, or organize files in the background."
                                       FontSize="10.5" Foreground="{DynamicResource NotchTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource DrawerChipButton}"
                                Background="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                VerticalAlignment="Center" MouseLeftButtonUp="UpgradePlan_OnClick">
                            <TextBlock x:Name="PlanGateAction" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Empty State with Friendly Helper Presets -->
                <Border x:Name="EmptyState" Background="{DynamicResource NotchBubbleBrush}" CornerRadius="12"
                        Padding="18,18" Margin="0,2" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="No background helpers running right now" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NotchTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose a quick helper below, or click '+ Start Helper' to set a custom goal:"
                                   FontSize="11" Foreground="{DynamicResource NotchMutedBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,3,0,12" TextAlignment="Center" MaxWidth="400" />

                        <!-- Friendly Helper Cards Grid -->
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource NotchSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotchHairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Cursor="Hand"
                                    Tag="study_tutor" MouseLeftButtonUp="PresetHelper_OnClick">
                                <StackPanel>
                                    <TextBlock Text="📚 Study &amp; Homework Tutor" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}" />
                                    <TextBlock Text="Explain concepts step-by-step with clear examples." FontSize="9.5" Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource NotchSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotchHairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Cursor="Hand"
                                    Tag="writing_assistant" MouseLeftButtonUp="PresetHelper_OnClick">
                                <StackPanel>
                                    <TextBlock Text="✍️ Writing &amp; Summary Helper" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}" />
                                    <TextBlock Text="Draft, proofread, or summarize notes and documents." FontSize="9.5" Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource NotchSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotchHairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Cursor="Hand"
                                    Tag="web_research" MouseLeftButtonUp="PresetHelper_OnClick">
                                <StackPanel>
                                    <TextBlock Text="🔍 Web Topic Researcher" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}" />
                                    <TextBlock Text="Search the web and create a neat research report." FontSize="9.5" Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource NotchSurfaceBrush}"
                                    BorderBrush="{DynamicResource NotchHairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Cursor="Hand"
                                    Tag="organize_downloads" MouseLeftButtonUp="PresetHelper_OnClick">
                                <StackPanel>
                                    <TextBlock Text="📁 File &amp; Download Organizer" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}" />
                                    <TextBlock Text="Safely tidy up your Downloads into sorted folders." FontSize="9.5" Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active Tasks ItemsControl -->
                <ItemsControl x:Name="TasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource NotchBubbleBrush}" CornerRadius="12" Margin="0,0,0,12" Padding="14,12">
                                <Grid>
                                    <!-- Six rows: goal, activity, steps, approval,
                                         artifacts, actions. Approval and artifacts
                                         used to share row 3 and drew on top of one
                                         another whenever a task both wanted approval
                                         and had already written a file — which is
                                         exactly the moment the user most needs to
                                         read both. -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Goal & Status Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Goal}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource NotchTextBrush}" TextWrapping="Wrap" />
                                        <Border Grid.Column="1" CornerRadius="4" Padding="7,2.5" Margin="8,0,0,0"
                                                VerticalAlignment="Top" Background="{DynamicResource NotchChipHoverBrush}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Progress & Current Activity -->
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding CurrentActivity}" FontSize="11" Foreground="{DynamicResource NotchMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="390" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ProgressPercentText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NotchTextBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="5"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource NotchChipEdgeBrush}"
                                                     BorderThickness="0" />
                                    </StackPanel>

                                    <!-- Multi-Step Plan & Execution List (Supports 100+ steps) -->
                                    <Border Grid.Row="2" Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,10,0,0" Visibility="{Binding StepsVisibility}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📋" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StepsSummaryText}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Multi-step execution" FontSize="9.5" Foreground="{DynamicResource NotchFaintBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Scrollable Step List for 100+ steps -->
                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="6" Background="{DynamicResource NotchChipBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Step Index -->
                                                                    <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource NotchChipHoverBrush}"
                                                                            Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding StepNumberText}" FontSize="9"
                                                                                   FontWeight="Bold" Foreground="{DynamicResource NotchTextBrush}" />
                                                                    </Border>

                                                                    <!-- Step Info -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                                   Foreground="{DynamicResource NotchTextBrush}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding ToolInfo}" FontSize="9.5"
                                                                                   Foreground="{DynamicResource NotchMutedBrush}" Margin="0,1,0,0"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="9.5"
                                                                                   Foreground="{DynamicResource NotchDangerInkBrush}" Margin="0,1,0,0"
                                                                                   TextWrapping="Wrap" Visibility="{Binding ErrorVisibility}" />
                                                                    </StackPanel>

                                                                    <!-- Verification Status Badge -->
                                                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,2" Margin="6,0,0,0"
                                                                            VerticalAlignment="Top" Background="{Binding StatusBgBrush}">
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="8.5" FontWeight="Bold"
                                                                                   Foreground="{Binding StatusBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Said, rather than left to be
                                                 inferred from a step list that
                                                 does not start at #1. -->
                                            <TextBlock Text="{Binding StepsTruncatedText}"
                                                       Visibility="{Binding StepsTruncatedVisibility}"
                                                       FontSize="9.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource NotchFaintBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Pending Approval Banner (if applicable) -->
                                    <Border Grid.Row="3" Background="{DynamicResource NotchWarningBedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                                            Visibility="{Binding ApprovalVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Approval Required" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding ApprovalReason}" FontSize="10.5" Foreground="{DynamicResource NotchTextBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <!-- What is actually being allowed. Approving without
                                                     seeing the tool and its arguments is not consent. -->
                                                <TextBlock FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WarningBrush}">
                                                    <Run Text="{Binding ApprovalTool, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="   " />
                                                    <Run Text="{Binding ApprovalRisk, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ApprovalArguments}" FontSize="10" Margin="0,3,0,0"
                                                           FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="52"
                                                           Foreground="{DynamicResource NotchMutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Border Style="{StaticResource DrawerChipButton}" Background="{DynamicResource StatusListeningBrush}"
                                                        Padding="10,0" Height="24" Margin="0,0,6,0" Tag="{Binding Id}"
                                                        MouseLeftButtonUp="ApproveTask_OnClick">
                                                    <TextBlock Text="Approve" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <Border Style="{StaticResource DrawerChipButton}" Background="{DynamicResource NotchDangerInkBrush}"
                                                        Padding="10,0" Height="24" Tag="{Binding Id}"
                                                        MouseLeftButtonUp="DenyTask_OnClick">
                                                    <TextBlock Text="Deny" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- What the agent actually produced. None of this was
                                         shown anywhere before, so a report an agent wrote could
                                         only be found by going looking on disk. -->
                                    <Border Grid.Row="4" Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,8,0,0"
                                            Visibility="{Binding ArtifactsVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ArtifactsSummaryText}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource NotchMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent" Cursor="Hand" Padding="0,3"
                                                                Tag="{Binding FilePath}"
                                                                ToolTip="{Binding FilePath}"
                                                                MouseLeftButtonUp="OpenArtifact_OnClick">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Summary}" FontSize="9.5"
                                                                               Foreground="{DynamicResource NotchFaintBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="9.5"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource NotchFaintBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Controls -->
                                    <Grid Grid.Row="5" Margin="0,10,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource NotchFaintBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320">
                                                <Run Text="{Binding TimeAgoText, Mode=OneWay}" />
                                                <Run Text="   " />
                                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource NotchFaintBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,1,0,0"
                                                       ToolTip="{Binding WorkingDirectory}">
                                                <Run Text="{Binding OriginText, Mode=OneWay}" />
                                                <Run Text="   " />
                                                <Run Text="{Binding WorkingDirectory, Mode=OneWay}" />
                                            </TextBlock>

                                            <!-- Whether this agent can touch
                                                 anything outside its own folder.
                                                 Beneath the folder path, because
                                                 the path alone does not tell you
                                                 whether it is a boundary or just
                                                 a starting point. -->
                                            <TextBlock Text="{Binding ScopeText}"
                                                       Visibility="{Binding ScopeVisibility}"
                                                       Foreground="{Binding ScopeBrush}"
                                                       FontSize="9.5" FontWeight="SemiBold"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Style="{StaticResource DrawerChipButton}" Background="{DynamicResource NotchAccentBedBrush}" Margin="0,0,6,0" Height="22" Padding="8,0"
                                                    Visibility="{Binding RetryVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="RetryTask_OnClick">
                                                <TextBlock Text="Retry" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource DrawerChipButton}" Margin="0,0,6,0" Height="22" Padding="8,0"
                                                    Visibility="{Binding PauseResumeVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="PauseResume_OnClick">
                                                <TextBlock Text="{Binding PauseResumeLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NotchTextBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource DrawerChipButton}" Background="{DynamicResource NotchDangerBedBrush}" Height="22" Padding="8,0"
                                                    Visibility="{Binding CancelVisibility}" Tag="{Binding Id}"
                                                    MouseLeftButtonUp="CancelTask_OnClick">
                                                <TextBlock Text="Cancel" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NotchDangerInkBrush}" />
                                            </Border>
                                            <!-- Finished tasks piled up forever: this list is also the
                                                 history, and nothing could remove an entry from it. -->
                                            <Border Style="{StaticResource DrawerChipButton}" Height="22" Padding="8,0"
                                                    Visibility="{Binding DismissVisibility}" Tag="{Binding Id}"
                                                    ToolTip="Remove this from the list"
                                                    MouseLeftButtonUp="DismissTask_OnClick">
                                                <TextBlock Text="Clear" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NotchMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Emergency Stop & Shortcut Reminder -->
        <Grid Grid.Row="2" Margin="16,8,16,6">
            <TextBlock Text="Ask Metis, or type /spawn  ·  Stop All ends every agent immediately" FontSize="10"
                       Foreground="{DynamicResource NotchFaintBrush}" VerticalAlignment="Center" />
            <Border Style="{StaticResource DrawerChipButton}" Background="{DynamicResource NotchDangerBedBrush}" HorizontalAlignment="Right"
                    Padding="10,0" Height="24" MouseLeftButtonUp="EmergencyStop_OnClick">
                <TextBlock Text="Stop All Agents" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource NotchDangerInkBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
