<Window x:Class="Metis.App.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Metis"
        Width="880" Height="640"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <!--
        The first-run flow. Unlike the anchored windows this one is centred and
        draggable: the notch is the app's landmark, but on first run the user
        does not know that yet, so the wizard teaches it and only folds into it
        at the end.
    -->
    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusWindow}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="8" Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: wordmark and step progress -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    CornerRadius="12,12,0,0" Padding="28,18"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"
                              Fill="{DynamicResource AccentBrush}"
                              Data="M34,8 C42,-1 56,-1 64,7 C72,15 72,27 66,35 C72,43 72,55 64,63 C56,71 44,71 35,65 C27,71 15,71 7,63 C-1,55 -1,43 5,35 C-1,27 -1,15 7,7 C15,-1 27,-1 34,8 Z" />
                        <TextBlock Text="metis" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="Black" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <ItemsControl x:Name="StepDots" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button x:Name="CloseButton" Content="✕" Style="{StaticResource ChromeButton}"
                            HorizontalAlignment="Right" ToolTip="Finish later" Click="Skip_OnClick" />
                </Grid>
            </Border>

            <!-- Steps. Only one is visible at a time; the code-behind owns which. -->
            <Grid Grid.Row="1" Margin="52,34,52,10">

                <!-- 0 · Welcome -->
                <StackPanel x:Name="Step0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MonoLabelText}"
                               Text="LEARN THE DIGITAL WORLD BY DOING" />
                    <TextBlock Style="{StaticResource DisplayText}" Margin="0,8,0,0"
                               Text="Metis teaches while you work." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,14,0,0" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="Most tools either tell you what to do somewhere else, or quietly do it for you. Metis does neither. It watches the app you are actually in, explains the parts you don't recognise, and shows you where to go — so the skill stays with you afterwards." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,12,0,0" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="It lives at the top of your screen. Pull down the notch whenever you are stuck." />
                    <!-- The notch is #0A0A0C, which is also the dark canvas, so
                         this mock needs an edge or it vanishes in dark mode. -->
                    <Border Margin="0,32,0,0" Width="300" HorizontalAlignment="Left"
                            Background="{DynamicResource NotchBodyBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,18,18" Height="52">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusListeningBrush}"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="This is the notch" FontSize="12.5"
                                       Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                               Text="It sits above everything, and tucks away until you need it." />
                </StackPanel>

                <!-- 1 · Reasoning provider -->
                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26"
                               Text="Where should Metis do its thinking?" />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,10,0,20"
                               Text="You can change this later in Preferences." />

                    <RadioButton x:Name="CloudChoice" Style="{StaticResource ChoiceCard}"
                                 GroupName="Brain" IsChecked="True" Checked="BrainChoice_OnChanged">
                        <StackPanel>
                            <TextBlock Text="Use a cloud model" Style="{StaticResource SubtitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Text="Gemini, OpenAI, or Claude. Faster and more capable. Needs an API key, and your screen and questions are sent to the provider you pick." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="LocalChoice" Style="{StaticResource ChoiceCard}"
                                 GroupName="Brain" Checked="BrainChoice_OnChanged">
                        <StackPanel>
                            <TextBlock Text="Keep everything on this PC — works offline" Style="{StaticResource SubtitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Text="Ollama, Whisper.cpp, and Piper. Nothing leaves your computer and no internet connection is needed once the models are installed. Slower, but it works where bandwidth is scarce or data costs money." />
                        </StackPanel>
                    </RadioButton>

                    <Border x:Name="CloudPanel" Style="{StaticResource UtilityCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProviderBox" Grid.Column="0" SelectionChanged="ProviderBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Gemini" IsSelected="True" />
                                    <ComboBoxItem Content="OpenAI" />
                                    <ComboBoxItem Content="Claude" />
                                    <ComboBoxItem Content="OpenRouter" />
                                </ComboBox>
                                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                                       Text="The key is stored in Windows Credential Manager, never in a settings file." />
                            <TextBlock x:Name="ProviderNote" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="OpenRouter has free models, but they are rate limited and many are served by providers that may log or train on what they receive — which here means pictures of your screen. For private work choose the fully local option instead." />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Test connection" Style="{StaticResource SecondaryButton}"
                                        Click="TestProvider_OnClick" />
                                <TextBlock x:Name="ProviderStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LocalPanel" Style="{StaticResource UtilityCard}" Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabelText}" Text="OLLAMA ENDPOINT" />
                            <TextBox x:Name="OllamaEndpointBox" Margin="0,6,0,12" Text="http://127.0.0.1:11434" />
                            <TextBlock Style="{StaticResource MonoLabelText}" Text="MODEL" />
                            <TextBox x:Name="OllamaModelBox" Margin="0,6,0,0" Text="qwen3-vl:2b-instruct-q4_K_M" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="2,10,0,0"
                                       Text="Choosing this also sets speech to Whisper.cpp and the voice to Piper. Install those before relying on it." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2 · Privacy consent -->
                <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26"
                               Text="Metis reads your screen only when you ask." />
                    <TextBlock x:Name="CaptureExplanation" Style="{StaticResource LeadText}" Margin="0,14,0,0" MaxWidth="660"
                               HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,12,0,0" MaxWidth="660"
                               HorizontalAlignment="Left"
                               Text="It also reads the names and labels of on-screen controls so it can point accurately. It cannot see inside apps running as administrator." />
                    <Border Style="{StaticResource UtilityCard}" Margin="0,24,0,0">
                        <CheckBox x:Name="CaptureScreenCheck" IsChecked="True"
                                  Content="Let Metis take a picture of my screen when I ask it something" />
                    </Border>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="2,10,0,0"
                               Text="With this off, Metis can still answer questions but cannot see or point at anything." />
                </StackPanel>

                <!-- 3 · What Metis is -->
                <StackPanel x:Name="Step3" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26"
                               Text="Metis teaches. It never takes over." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,14,0,0" MaxWidth="660"
                               HorizontalAlignment="Left"
                               Text="Ask how to do something and Metis shows you — it marks the screen where to look and talks you through it, one step at a time, while you do it yourself. It never clicks, types, or opens anything for you, because the point is that you learn how." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,12,0,0" MaxWidth="660"
                               HorizontalAlignment="Left"
                               Text="It teaches software the same way it teaches a subject: ask about a shape, a cell, or a force and it draws the diagram as it explains." />
                </StackPanel>

                <!-- 4 · Shortcuts. This is the taught-by-doing part of the guide. -->
                <StackPanel x:Name="Step4" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26" Text="Keys to remember." />
                    <StackPanel Margin="0,22,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeycapChip}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl + Shift + 1  /  Ctrl + Shift + A" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LeadText}"
                                       Text="Hold to talk · Spawn autonomous voice agent" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeycapChip}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl + Alt" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LeadText}"
                                       Text="Ask about what's on screen (Context)" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeycapChip}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl + Alt + Shift" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LeadText}"
                                       Text="Point at something under the pointer" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeycapChip}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl + Space" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LeadText}"
                                       Text="Continuous listen hands-free until wake word" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeycapChip}" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource KeycapText}" Text="F12" />
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LeadText}"
                                       Text="Stop guidance and emergency stop all agents" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource UtilityCard}" Margin="0,22,0,0" Padding="16">
                        <StackPanel>
                            <CheckBox x:Name="ContextShortcutsCheck" IsChecked="True"
                                      Content="Enable the Ctrl+Alt screen shortcuts" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="48,6,0,0"
                                       Text="Ctrl+Space listens in background for the wake word. F12 cancels guidance and all running agents instantly." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5 · Voice -->
                <StackPanel x:Name="Step5" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26" Text="Talking and listening." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,10,0,20"
                               Text="Optional — you can always type instead." />
                    <Border Style="{StaticResource UtilityCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabelText}" Text="MICROPHONE" />
                            <ComboBox x:Name="MicrophoneBox" Margin="0,6,0,0" />
                            <TextBlock x:Name="MicrophoneStatus" Style="{StaticResource CaptionText}" Margin="2,8,0,0" />
                            <Button x:Name="OpenMicSettings" Content="Open Windows microphone settings"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Visibility="Collapsed" Click="OpenMicSettings_OnClick" />
                            <Border Style="{StaticResource Separator}" />
                            <CheckBox x:Name="SpeechEnabledCheck" IsChecked="True"
                                      Content="Let Metis speak its answers out loud" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6 · Personalisation -->
                <StackPanel x:Name="Step6" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" FontSize="26" Text="Make it yours." />
                    <Border Style="{StaticResource UtilityCard}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabelText}" Text="COMPANION COLOUR" />
                            <ItemsControl x:Name="ColourSwatches" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Border Style="{StaticResource Separator}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Size" VerticalAlignment="Center" />
                                <Slider x:Name="CompanionSizeSlider" Grid.Column="1" Minimum="32" Maximum="112"
                                        Value="56" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompanionSizeValue" Grid.Column="2" Width="40"
                                           TextAlignment="Right" VerticalAlignment="Center" Text="56" />
                            </Grid>

                            <Border Style="{StaticResource Separator}" />

                            <TextBlock Style="{StaticResource MonoLabelText}" Text="APPEARANCE" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Follow Windows"
                                             IsChecked="True" Margin="0,0,20,0" Checked="Theme_OnChanged" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light"
                                             Margin="0,0,20,0" Checked="Theme_OnChanged" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark"
                                             Checked="Theme_OnChanged" />
                            </StackPanel>

                            <Border Style="{StaticResource Separator}" />

                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start Metis when I sign in to Windows" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7 · Done. The rest of the guide: what to actually ask it. -->
                <StackPanel x:Name="Step7" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DisplayText}" Text="You're set." />
                    <TextBlock Style="{StaticResource LeadText}" Margin="0,12,0,0" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Pull down the notch and try one of these to see what Metis does." />

                    <Border Style="{StaticResource UtilityCard}" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MonoLabelText}" Text="THINGS TO TRY" />
                            <TextBlock Style="{StaticResource LeadText}" Margin="0,12,0,0"
                                       Text="&quot;What am I looking at?&quot;" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                       Text="Metis reads the screen and explains it." />
                            <TextBlock Style="{StaticResource LeadText}" Margin="0,14,0,0"
                                       Text="&quot;Where do I change the font size here?&quot;" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                       Text="It draws an arrow at the control instead of describing it." />
                            <TextBlock Style="{StaticResource LeadText}" Margin="0,14,0,0"
                                       Text="&quot;Walk me through exporting this as a PDF.&quot;" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                       Text="One step at a time, waiting for you between each." />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SafetyNote" Style="{StaticResource CaptionText}" Margin="2,16,0,0" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="Metis only ever shows and explains. It never clicks, types, opens, buys, sends, or changes anything — every step is yours, which is how the skill stays with you." />

                    <Border Style="{StaticResource Separator}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Metis" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}"
                    CornerRadius="0,0,12,12" Padding="28,16"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Visibility="Hidden" Click="Back_OnClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SkipButton" Content="Skip setup" Style="{StaticResource QuietButton}"
                                Margin="0,0,10,0" Click="Skip_OnClick" />
                        <Button x:Name="NextButton" Content="Get started" MinWidth="130" Click="Next_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
