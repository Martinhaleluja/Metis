<Window x:Class="Metis.App.Windows.TraceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis trace"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross">
    <!-- Unlike the guidance overlay this window deliberately takes mouse input.
         Keeping the two separate means a fault here can never leave the
         presentational layer swallowing the user's clicks. -->
    <Grid x:Name="Root">
        <!-- A near-transparent fill is required for the grid to receive mouse
             events at all; fully transparent areas are not hit-testable. -->
        <Rectangle x:Name="Scrim" Fill="#01000000" />
        <Canvas x:Name="InkCanvas" IsHitTestVisible="False" />
        <Border x:Name="Hint"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#E6111318" CornerRadius="6" Padding="10,6"
                IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="HintText" Text="Trace an area" Foreground="#F2F4F8"
                       FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
