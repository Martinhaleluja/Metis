<UserControl x:Class="Metis.App.Windows.NotchChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- The chat lives inside the notch body. Both follow the theme: the
         colours below are theme tokens rather than literals, because the notch
         used to stay dark in light mode while the app-wide TextBlock style
         painted Foreground from the themed Text token, which turned any text
         that did not set its own colour near-black on a black panel. Every
         reference is DynamicResource so a theme change re-resolves in place. -->
    <UserControl.Resources>

        <!-- Icons are drawn geometry rather than font characters, for the same
             reason the trace tools are: a glyph is whatever the installed font
             decides it is, and a row of them never lines up. -->
        <Style x:Key="ChatIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource NotchTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- A quiet round target that only paints on hover, so the header reads
             as a line of icons rather than a row of buttons. -->
        <Style x:Key="ChatIconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatChip" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="8,0,9,0" />
            <Setter Property="Background" Value="{DynamicResource NotchChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchChipEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchChipHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The app-wide scrollbar is a dark rail meant for a light panel, so it
             disappears against the notch. This is the same shape in the
             opposite polarity. -->
        <Style x:Key="ChatScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Rail" Background="{DynamicResource NotchScrollThumbBrush}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource NotchScrollThumbHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ChatScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScroller" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}" />
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ChatScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the model and conversation menus. Plain borders rather than
             ListBoxItems, so they carry the notch's own hover colour instead of
             the system highlight, which is a light blue bar. -->
        <Style x:Key="ChatMenuRow" TargetType="Border">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================
             The model picker sits on the left because it is the one choice that
             changes what an answer costs, and the actions that manage the
             conversation sit on the right. -->
        <Grid Grid.Row="0" Height="42" Margin="12,0,8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="ModelChip" Style="{StaticResource ChatChip}"
                        MaxWidth="180" ToolTip="Choose the model that answers" Margin="0,0,6,0"
                        MouseLeftButtonUp="ModelChip_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="TierBadge" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                VerticalAlignment="Center" Background="#30B158">
                            <TextBlock x:Name="TierLabel" Text="FREE" FontSize="8.5" FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ModelName" Text="Model" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Path Width="10" Height="10" Margin="6,1,0,0" Stretch="None"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" VerticalAlignment="Center"
                              Stroke="{DynamicResource NotchMutedBrush}"
                              Data="M 1.6,3.4 L 5,6.8 L 8.4,3.4" />
                    </StackPanel>
                </Border>

                <Border x:Name="SpawnAgentChip" Style="{StaticResource ChatChip}"
                        ToolTip="Spawn an autonomous background agent (Ctrl+Shift+A / Ctrl+Shift+1)"
                        MouseLeftButtonUp="SpawnAgentChip_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Spawn Agent" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Active Agent Colored Dots Cluster -->
                <ItemsControl x:Name="AgentDotsControl" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="Active background agents (click to open drawer, Ctrl+Shift+A)"
                              MouseLeftButtonUp="AgentDots_OnClick" Cursor="Hand">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0" VerticalAlignment="Center" ToolTip="{Binding Tooltip}">
                                <Ellipse Width="11" Height="11" Fill="{Binding DotBrush}" Opacity="0.35" />
                                <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="StopButton" Style="{StaticResource ChatIconButton}" Visibility="Collapsed"
                        ToolTip="Stop what Metis is doing" MouseLeftButtonUp="Stop_OnClick">
                    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource NotchDangerInkBrush}" />
                </Border>
                <Border x:Name="HistoryButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Earlier conversations" MouseLeftButtonUp="History_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{DynamicResource NotchMutedBrush}"
                          Data="M 3.6,8 A 4.9,4.9 0 1 1 5.1,11.6   M 3.6,8 L 1.4,5.9   M 3.6,8 L 5.9,5.9
                                M 8,5.4 L 8,8.2 L 10.2,9.5" />
                </Border>
                <Border x:Name="NewChatButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Start a fresh conversation" MouseLeftButtonUp="NewChat_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{DynamicResource NotchMutedBrush}"
                          Data="M 8,3.4 L 8,12.6   M 3.4,8 L 12.6,8" />
                </Border>
                <Border x:Name="SetupButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Metis setup" MouseLeftButtonUp="Setup_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{DynamicResource NotchMutedBrush}"
                          Data="M 2.8,4.6 L 13.2,4.6   M 2.8,8 L 13.2,8   M 2.8,11.4 L 13.2,11.4
                                M 6.1,3.2 L 6.1,6   M 10.4,6.6 L 10.4,9.4   M 5,10 L 5,12.8" />
                </Border>
                <Border x:Name="CollapseButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Put the chat away" MouseLeftButtonUp="Collapse_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{DynamicResource NotchMutedBrush}"
                          Data="M 4,9.8 L 8,5.8 L 12,9.8" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================= Update Banner ======================= -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Margin="14,2,14,6" Background="{DynamicResource NotchAccentBedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="UpdateTitle" Text="Update available" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}" />
                    <TextBlock x:Name="UpdateSubtitle" Text="Click update and Metis will automatically restart."
                               FontSize="10.5" Foreground="{DynamicResource NotchMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource ChatChip}"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                        Padding="14,0" Height="28" CornerRadius="14" VerticalAlignment="Center"
                        MouseLeftButtonUp="UpdateButton_OnClick">
                    <TextBlock x:Name="UpdateActionLabel" Text="Update" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ============================ Plan ==============================
             The same accent bed the update banner uses, for the other thing
             that happens to a turn rather than in it: the plan ran out, or does
             not include what was just asked for.

             It sits in the same row as the update banner because the two are
             never both worth showing at once, and stacking them would push the
             conversation down for a reason nobody asked about. -->
        <Border x:Name="PlanBanner" Grid.Row="1" Margin="14,2,14,6" Background="{DynamicResource NotchAccentBedBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="PlanBannerTitle" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource NotchTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PlanBannerSubtitle" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="PlanBannerButton" Grid.Column="1" Style="{StaticResource ChatChip}"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0"
                        Padding="14,0" Height="28" CornerRadius="14" VerticalAlignment="Center"
                        MouseLeftButtonUp="PlanBannerButton_OnClick">
                    <TextBlock x:Name="PlanBannerActionLabel" Text="See plans" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ========================== Transcript ==========================
             The row is Auto rather than star-sized, so the panel is exactly as
             tall as the conversation until the conversation outgrows the cap.
             That is what lets the notch grow with what is in it instead of
             opening at one fixed size. -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" MaxHeight="330"
                      Style="{StaticResource ChatScroller}" Padding="14,2,10,6">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3" RenderTransformOrigin="0,1">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="BubbleScale"
                                                    ScaleX="{DynamicResource BubbleEnterScale}"
                                                    ScaleY="{DynamicResource BubbleEnterScale}" />
                                    <TranslateTransform x:Name="BubbleRise" Y="{DynamicResource BubbleEnterRise}" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The ink color is set on the TextBlock directly with a local value to beat
                                 the global TextBlock style in Controls.xaml. Triggers below override it
                                 by targetting the TextBlock by name. -->
                            <Border x:Name="Bubble" Padding="12,8" MaxWidth="430"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource NotchBubbleBrush}"
                                    CornerRadius="16,16,16,5">
                                <TextBlock x:Name="BubbleText" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource NotchTextBrush}"
                                           FontSize="13" LineHeight="18" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BubbleRise"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding Author}" Value="You">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,5,16" />
                                <Setter TargetName="BubbleText" Property="Foreground" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Author}" Value="Problem">
                                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource NotchDangerBedBrush}" />
                                <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource NotchDangerInkBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- =========================== Composer ===========================
             The field grows with what is typed into it, and the notch grows
             with the field. -->
        <Grid Grid.Row="3" Margin="14,2,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ComposerField" Background="{DynamicResource NotchFieldBrush}" CornerRadius="16"
                    BorderBrush="{DynamicResource NotchFieldEdgeBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Ask Metis about your screen…"
                               Margin="14,0" FontSize="13" IsHitTestVisible="False"
                               Foreground="{DynamicResource NotchFaintBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="118" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="13,7"
                             FontSize="13" Foreground="{DynamicResource NotchTextBrush}"
                             CaretBrush="{DynamicResource NotchTextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             TextChanged="PromptBox_OnTextChanged"
                             PreviewKeyDown="PromptBox_OnPreviewKeyDown" />
                </Grid>
            </Border>
            <Border x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Width="32" Height="32"
                    CornerRadius="16" Background="{DynamicResource AccentBrush}" Cursor="Hand"
                    VerticalAlignment="Bottom" ToolTip="Send"
                    MouseLeftButtonUp="Send_OnClick">
                <Path Style="{StaticResource ChatIcon}" Stroke="White" StrokeThickness="1.7"
                      Data="M 8,12.6 L 8,3.8   M 4.2,7.6 L 8,3.8 L 11.8,7.6" />
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Grid Grid.Row="4" Margin="18,7,18,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#30D158"
                         Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="10.5"
                           Foreground="{DynamicResource NotchMutedBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="290" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                       Foreground="{DynamicResource NotchFaintBrush}"
                       Text="Enter to send  ·  Ctrl+Alt screen  ·  Ctrl+Shift+1 voice  ·  Esc closes" />
            <ProgressBar x:Name="VoiceLevel" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-7"
                         Minimum="0" Maximum="1" Value="0" Visibility="Hidden"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource NotchHoverBrush}"
                         BorderThickness="0" />
        </Grid>

        <!-- ============================= Menus =============================
             Popups rather than ComboBoxes: a system combo drops a light list
             carrying the OS highlight colour onto a black notch, and its popup
             cannot be persuaded to match. -->
        <Popup x:Name="ModelMenu" PlacementTarget="{Binding ElementName=ModelChip}"
               Placement="Bottom" VerticalOffset="6" HorizontalOffset="-4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource NotchFieldEdgeBrush}" BorderThickness="1" Padding="6" Width="360">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NotchShadow}" BlurRadius="22" ShadowDepth="5" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ModelMenuHeading" Margin="10,6,10,6" FontSize="10.5"
                               Foreground="{DynamicResource NotchFaintBrush}" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" Style="{StaticResource ChatScroller}">
                        <ItemsControl x:Name="ModelMenuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChatMenuRow}"
                                            MouseLeftButtonUp="ModelRow_OnClick" Tag="{Binding Id}">
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Padding="4,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Background="{Binding TierBrush}">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="8.5"
                                                           FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource NotchMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Width="14" Height="14" Margin="8,0,2,0"
                                                  Stretch="None" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  Data="M 3,7.4 L 6,10.4 L 11.4,4"
                                                  Visibility="{Binding TickVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="HistoryMenu" PlacementTarget="{Binding ElementName=HistoryButton}"
               Placement="Bottom" VerticalOffset="6" HorizontalOffset="-244"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="14"
                    BorderBrush="{DynamicResource NotchFieldEdgeBrush}" BorderThickness="1" Padding="6" Width="300">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource NotchShadow}" BlurRadius="22" ShadowDepth="5" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Earlier conversations" Margin="10,6,10,6" FontSize="10.5"
                               Foreground="{DynamicResource NotchFaintBrush}" />
                    <ScrollViewer MaxHeight="300" Style="{StaticResource ChatScroller}">
                        <ItemsControl x:Name="HistoryMenuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChatMenuRow}"
                                            MouseLeftButtonUp="HistoryRow_OnClick" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource NotchTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource NotchMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Path Grid.Column="1" Width="14" Height="14" Margin="8,0,2,0"
                                                  Stretch="None" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  Data="M 3,7.4 L 6,10.4 L 11.4,4"
                                                  Visibility="{Binding TickVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Height="1" Background="{DynamicResource NotchHairlineBrush}" Margin="6,6,6,4" />
                    <Border Style="{StaticResource ChatMenuRow}" MouseLeftButtonUp="NewChat_OnClick">
                        <TextBlock Text="New chat" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
