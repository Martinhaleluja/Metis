<UserControl x:Class="Metis.App.Windows.NotchChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- The chat lives inside the notch body, which is the one surface in Metis
         that keeps its own colours in every theme: it hangs off the top edge of
         the screen over whatever the user is working in, so it stays dark
         whether or not the rest of the app is light. Every colour here is
         therefore a literal rather than a theme token. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="ChatInk" Color="#F2F2F7" />
        <SolidColorBrush x:Key="ChatMuted" Color="#8E8E93" />
        <SolidColorBrush x:Key="ChatFaint" Color="#5A5A61" />
        <SolidColorBrush x:Key="ChatHairline" Color="#1F1F24" />
        <SolidColorBrush x:Key="ChatField" Color="#17171B" />
        <SolidColorBrush x:Key="ChatFieldEdge" Color="#2C2C33" />
        <SolidColorBrush x:Key="ChatSurface" Color="#121215" />
        <SolidColorBrush x:Key="ChatBubble" Color="#1C1C21" />
        <SolidColorBrush x:Key="ChatAccent" Color="#0A7CFF" />
        <SolidColorBrush x:Key="ChatDangerInk" Color="#FF6257" />
        <SolidColorBrush x:Key="ChatDangerBed" Color="#2A1517" />

        <!-- Icons are drawn geometry rather than font characters, for the same
             reason the trace tools are: a glyph is whatever the installed font
             decides it is, and a row of them never lines up. -->
        <Style x:Key="ChatIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource ChatInk}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- A quiet round target that only paints on hover, so the header reads
             as a line of icons rather than a row of buttons. -->
        <Style x:Key="ChatIconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatChip" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="8,0,9,0" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The app-wide scrollbar is a dark rail meant for a light panel, so it
             disappears against the notch. This is the same shape in the
             opposite polarity. -->
        <Style x:Key="ChatScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Rail" Background="#33FFFFFF" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ChatScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatScroller" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}" />
                            <ScrollBar Grid.Column="1" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource ChatScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the model and conversation menus. Plain borders rather than
             ListBoxItems, so they carry the notch's own hover colour instead of
             the system highlight, which is a light blue bar. -->
        <Style x:Key="ChatMenuRow" TargetType="Border">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================
             The model picker sits on the left because it is the one choice that
             changes what an answer costs, and the actions that manage the
             conversation sit on the right. -->
        <Grid Grid.Row="0" Height="42" Margin="12,0,8,0">
            <Border x:Name="ModelChip" Style="{StaticResource ChatChip}" HorizontalAlignment="Left"
                    MaxWidth="260" ToolTip="Choose the model that answers"
                    MouseLeftButtonUp="ModelChip_OnClick">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="TierBadge" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                            VerticalAlignment="Center" Background="#30B158">
                        <TextBlock x:Name="TierLabel" Text="FREE" FontSize="8.5" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <TextBlock x:Name="ModelName" Text="Model" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource ChatInk}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Path Width="10" Height="10" Margin="6,1,0,0" Stretch="None"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" VerticalAlignment="Center"
                          Stroke="{StaticResource ChatMuted}"
                          Data="M 1.6,3.4 L 5,6.8 L 8.4,3.4" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="StopButton" Style="{StaticResource ChatIconButton}" Visibility="Collapsed"
                        ToolTip="Stop what Metis is doing" MouseLeftButtonUp="Stop_OnClick">
                    <Border Width="9" Height="9" CornerRadius="2" Background="{StaticResource ChatDangerInk}" />
                </Border>
                <Border x:Name="HistoryButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Earlier conversations" MouseLeftButtonUp="History_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{StaticResource ChatMuted}"
                          Data="M 3.6,8 A 4.9,4.9 0 1 1 5.1,11.6   M 3.6,8 L 1.4,5.9   M 3.6,8 L 5.9,5.9
                                M 8,5.4 L 8,8.2 L 10.2,9.5" />
                </Border>
                <Border x:Name="NewChatButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Start a fresh conversation" MouseLeftButtonUp="NewChat_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{StaticResource ChatMuted}"
                          Data="M 8,3.4 L 8,12.6   M 3.4,8 L 12.6,8" />
                </Border>
                <Border x:Name="SetupButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Metis setup" MouseLeftButtonUp="Setup_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{StaticResource ChatMuted}"
                          Data="M 2.8,4.6 L 13.2,4.6   M 2.8,8 L 13.2,8   M 2.8,11.4 L 13.2,11.4
                                M 6.1,3.2 L 6.1,6   M 10.4,6.6 L 10.4,9.4   M 5,10 L 5,12.8" />
                </Border>
                <Border x:Name="CollapseButton" Style="{StaticResource ChatIconButton}"
                        ToolTip="Put the chat away" MouseLeftButtonUp="Collapse_OnClick">
                    <Path Style="{StaticResource ChatIcon}" Stroke="{StaticResource ChatMuted}"
                          Data="M 4,9.8 L 8,5.8 L 12,9.8" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================= Update Banner ======================= -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Margin="14,2,14,6" Background="#240A7CFF"
                BorderBrush="{StaticResource ChatAccent}" BorderThickness="1"
                CornerRadius="10" Padding="12,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="UpdateTitle" Text="Update available" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource ChatInk}" />
                    <TextBlock x:Name="UpdateSubtitle" Text="Click update and Metis will automatically restart."
                               FontSize="10.5" Foreground="{StaticResource ChatMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource ChatChip}"
                        Background="{StaticResource ChatAccent}" BorderThickness="0"
                        Padding="14,0" Height="28" CornerRadius="14" VerticalAlignment="Center"
                        MouseLeftButtonUp="UpdateButton_OnClick">
                    <TextBlock x:Name="UpdateActionLabel" Text="Update" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ========================== Transcript ==========================
             The row is Auto rather than star-sized, so the panel is exactly as
             tall as the conversation until the conversation outgrows the cap.
             That is what lets the notch grow with what is in it instead of
             opening at one fixed size. -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" MaxHeight="330"
                      Style="{StaticResource ChatScroller}" Padding="14,2,10,6">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3" RenderTransformOrigin="0,1">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.94" ScaleY="0.94" />
                                    <TranslateTransform x:Name="BubbleRise" Y="7" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- The ink colour is set on the bubble rather than
                                 on the TextBlock inside it: a local value on the
                                 child would beat inheritance, and the triggers
                                 below could never recolour it. -->
                            <Border x:Name="Bubble" Padding="12,8" MaxWidth="430"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ChatBubble}"
                                    TextBlock.Foreground="{StaticResource ChatInk}"
                                    CornerRadius="16,16,16,5">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           FontSize="13" LineHeight="18" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BubbleRise"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <DataTrigger Binding="{Binding Author}" Value="You">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ChatAccent}" />
                                <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,5,16" />
                                <Setter TargetName="Bubble" Property="TextBlock.Foreground" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Author}" Value="Problem">
                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ChatDangerBed}" />
                                <Setter TargetName="Bubble" Property="TextBlock.Foreground" Value="{StaticResource ChatDangerInk}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- =========================== Composer ===========================
             The field grows with what is typed into it, and the notch grows
             with the field. -->
        <Grid Grid.Row="3" Margin="14,2,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ComposerField" Background="{StaticResource ChatField}" CornerRadius="16"
                    BorderBrush="{StaticResource ChatFieldEdge}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Ask Metis about your screen…"
                               Margin="14,0" FontSize="13" IsHitTestVisible="False"
                               Foreground="{StaticResource ChatFaint}" VerticalAlignment="Center" />
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="118" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="13,7"
                             FontSize="13" Foreground="{StaticResource ChatInk}"
                             CaretBrush="{StaticResource ChatInk}"
                             SelectionBrush="{StaticResource ChatAccent}"
                             TextChanged="PromptBox_OnTextChanged"
                             PreviewKeyDown="PromptBox_OnPreviewKeyDown" />
                </Grid>
            </Border>
            <Border x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Width="32" Height="32"
                    CornerRadius="16" Background="{StaticResource ChatAccent}" Cursor="Hand"
                    VerticalAlignment="Bottom" ToolTip="Send"
                    MouseLeftButtonUp="Send_OnClick">
                <Path Style="{StaticResource ChatIcon}" Stroke="White" StrokeThickness="1.7"
                      Data="M 8,12.6 L 8,3.8   M 4.2,7.6 L 8,3.8 L 11.8,7.6" />
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Grid Grid.Row="4" Margin="18,7,18,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#30D158"
                         Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="10.5"
                           Foreground="{StaticResource ChatMuted}"
                           TextTrimming="CharacterEllipsis" MaxWidth="290" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5"
                       Foreground="{StaticResource ChatFaint}"
                       Text="Enter to send  ·  Ctrl+Alt asks about the screen  ·  Esc closes" />
            <ProgressBar x:Name="VoiceLevel" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-7"
                         Minimum="0" Maximum="1" Value="0" Visibility="Hidden"
                         Foreground="{StaticResource ChatAccent}" Background="#1FFFFFFF"
                         BorderThickness="0" />
        </Grid>

        <!-- ============================= Menus =============================
             Popups rather than ComboBoxes: a system combo drops a light list
             carrying the OS highlight colour onto a black notch, and its popup
             cannot be persuaded to match. -->
        <Popup x:Name="ModelMenu" PlacementTarget="{Binding ElementName=ModelChip}"
               Placement="Bottom" VerticalOffset="6" HorizontalOffset="-4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource ChatSurface}" CornerRadius="14"
                    BorderBrush="#2C2C33" BorderThickness="1" Padding="6" Width="360">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ModelMenuHeading" Margin="10,6,10,6" FontSize="10.5"
                               Foreground="{StaticResource ChatFaint}" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" Style="{StaticResource ChatScroller}">
                        <ItemsControl x:Name="ModelMenuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChatMenuRow}"
                                            MouseLeftButtonUp="ModelRow_OnClick" Tag="{Binding Id}">
                                        <Border.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="3" Padding="4,1" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" Background="{Binding TierBrush}">
                                                <TextBlock Text="{Binding TierLabel}" FontSize="8.5"
                                                           FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource ChatInk}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{StaticResource ChatMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Width="14" Height="14" Margin="8,0,2,0"
                                                  Stretch="None" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{StaticResource ChatAccent}"
                                                  Data="M 3,7.4 L 6,10.4 L 11.4,4"
                                                  Visibility="{Binding TickVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="HistoryMenu" PlacementTarget="{Binding ElementName=HistoryButton}"
               Placement="Bottom" VerticalOffset="6" HorizontalOffset="-244"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource ChatSurface}" CornerRadius="14"
                    BorderBrush="#2C2C33" BorderThickness="1" Padding="6" Width="300">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.5" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Earlier conversations" Margin="10,6,10,6" FontSize="10.5"
                               Foreground="{StaticResource ChatFaint}" />
                    <ScrollViewer MaxHeight="300" Style="{StaticResource ChatScroller}">
                        <ItemsControl x:Name="HistoryMenuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChatMenuRow}"
                                            MouseLeftButtonUp="HistoryRow_OnClick" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource ChatInk}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{StaticResource ChatMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Path Grid.Column="1" Width="14" Height="14" Margin="8,0,2,0"
                                                  Stretch="None" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Stroke="{StaticResource ChatAccent}"
                                                  Data="M 3,7.4 L 6,10.4 L 11.4,4"
                                                  Visibility="{Binding TickVisibility}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Height="1" Background="{StaticResource ChatHairline}" Margin="6,6,6,4" />
                    <Border Style="{StaticResource ChatMenuRow}" MouseLeftButtonUp="NewChat_OnClick">
                        <TextBlock Text="New chat" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource ChatAccent}" />
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
