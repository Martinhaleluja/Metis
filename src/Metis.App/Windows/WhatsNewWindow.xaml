<Window x:Class="Metis.App.Windows.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in Metis"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource CanvasBrush}">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadge" Text="v3.13.0" FontSize="11"
                               FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock Text="What's new" Style="{StaticResource PageTitleText}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Metis can hand real work to background agents now — and most of this release is about making them able to finish it." />

            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,0" />
        </StackPanel>

        <!-- The changes. Built in code so each entry can fade in, and so the
             list lives in one place to edit for the next release. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel x:Name="ChangeList" />
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Built by Martin Nakasole" />
            <Button x:Name="CloseButton" Content="Get started" HorizontalAlignment="Right"
                    MinWidth="110" Click="Close_OnClick" />
        </Grid>
    </Grid>
</Window>
