<Window x:Class="Metis.App.Windows.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:Metis.App.Windows"
        Title="Metis"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Width="560" Height="64">
    <Window.Resources>
        <!-- Tool buttons carry their own motion: a lift on hover and a press
             inward on click, both inside the 150-300ms band. Scaling from the
             centre keeps them from nudging their neighbours. -->
        <!-- Icons are drawn geometry, not font characters. Glyphs like ✎ and ⛶
             are whatever the installed font decides they are: different weights,
             different optical sizes, different vertical alignment from one to
             the next, which is what made the row look unstyled. -->
        <Style x:Key="TraceToolIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource NotchTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TraceToolButton" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource NotchToolBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.12" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.12" Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="0.9" Duration="0:0:0.08" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="0.9" Duration="0:0:0.08" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!--
        No background at all, rather than Transparent.

        A Transparent brush is hit-testable — that is the standard idiom for
        making blank area clickable — so the window's empty margin was quietly
        swallowing every click that landed on it. That was survivable while the
        notch stayed 64 pixels tall and only as wide as it needed to be; once it
        can grow to most of the screen it would take the desktop with it.

        With no brush the hit test finds nothing, the window answers
        HTTRANSPARENT, and the click reaches whatever is underneath. NotchBody
        keeps a real brush and stays clickable; the drop shadow renders pixels
        but effects do not take part in hit testing, so it is click-through too.
        NotchWindow.PassThroughIsWorking checks this at runtime rather than
        trusting the reasoning.
    -->
    <Grid Background="{x:Null}">
        <!-- The notch hangs off the top edge, so only the bottom corners are
             rounded. It is always present while Metis runs: tucked to a thin
             sliver when idle, expanded when there is something to say, and
             opened out into the chat when the user pulls it down. The chat has
             no window of its own — this is it. -->
        <Border x:Name="NotchBody"
                Background="{DynamicResource NotchBodyBrush}"
                BorderBrush="{DynamicResource NotchGlassBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="0,0,24,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="104" Height="34"
                Cursor="Hand"
                MouseLeftButtonDown="Notch_OnMouseLeftButtonDown"
                MouseLeftButtonUp="Notch_OnMouseLeftButtonUp"
                MouseMove="Notch_OnMouseMove"
                MouseEnter="Notch_OnMouseEnter"
                MouseLeave="Notch_OnMouseLeave"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotchDrop" Y="-22" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource NotchShadow}" BlurRadius="22" ShadowDepth="4" Opacity="0.45" />
            </Border.Effect>

            <!-- Clipped, because the body's height is animated and the chat
                 inside it is taller than the body for the whole of the opening
                 motion. Without this the panel spills out of the notch and
                 hangs unattached over the screen while it grows. -->
            <Grid ClipToBounds="True">
                <!-- Living Aurora Gradient Mesh (Animated Green, Blue, Pink, Cyan, Orange gradients) -->
                <Grid x:Name="AuroraMesh" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.32">
                    <!-- Green / Emerald Orb -->
                    <Ellipse x:Name="AuroraOrb1" Width="180" Height="140" Fill="{DynamicResource AuroraGreenBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-40,-40,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraOrb1Transform" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="55" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Cyan / Sky Blue Orb -->
                    <Ellipse x:Name="AuroraOrb2" Width="220" Height="150" Fill="{DynamicResource AuroraCyanBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-50,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraOrb2Transform" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="60" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Electric Blue Orb -->
                    <Ellipse x:Name="AuroraOrb3" Width="200" Height="160" Fill="{DynamicResource AuroraBlueBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraOrb3Transform" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="65" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Neon Pink / Magenta Orb -->
                    <Ellipse x:Name="AuroraOrb4" Width="190" Height="150" Fill="{DynamicResource AuroraPinkBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-20,0,0,-40">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraOrb4Transform" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="55" />
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Sunset Orange Orb -->
                    <Ellipse x:Name="AuroraOrb5" Width="190" Height="150" Fill="{DynamicResource AuroraOrangeBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-40">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="AuroraOrb5Transform" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="60" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <!-- Glass Specular Highlight Sheen across top edge -->
                <Border IsHitTestVisible="False" Background="{DynamicResource NotchGlassSheenBrush}" Height="20" VerticalAlignment="Top" />

                <!-- Everything that belongs to the resting notch is pinned to
                     the top strip, so it does not drift to the middle of the
                     panel when the body grows into the chat. -->
                <Grid x:Name="PillLayer" Height="34" VerticalAlignment="Top">
                    <!-- Tucked state: a grabber bar, so the notch reads as
                         something you can pull rather than a stray black shape. -->
                    <Border x:Name="Grabber" Width="34" Height="3.5" CornerRadius="2"
                            Background="{DynamicResource NotchGrabberBrush}" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.85" />

                    <Grid x:Name="NotchContent" Margin="14,0" Opacity="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse x:Name="PulseHalo" Width="16" Height="16"
                                         Fill="{DynamicResource StatusThinkingBrush}" Opacity="0.28" />
                                <Ellipse x:Name="StatusLight" Width="8" Height="8"
                                         Fill="{DynamicResource StatusThinkingBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Name="ActivityText" Text="" VerticalAlignment="Center"
                                       Foreground="{DynamicResource NotchTextBrush}" FontSize="12.5" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />

                            <ItemsControl x:Name="StepPips" VerticalAlignment="Center" Margin="10,1,0,0"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel x:Name="ThinkingDots" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="10,1,0,0" Visibility="Collapsed">
                                <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="{DynamicResource NotchMutedBrush}" Margin="0,0,4,0" />
                                <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="{DynamicResource NotchMutedBrush}" Margin="0,0,4,0" />
                                <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="{DynamicResource NotchMutedBrush}" />
                            </StackPanel>

                            <!-- Active Agent Colored Dots in Resting Notch -->
                            <ItemsControl x:Name="NotchAgentDots" VerticalAlignment="Center" Margin="8,1,0,0"
                                          Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="AgentDots_OnClick"
                                          ToolTip="Active background agents (click to open drawer, Ctrl+Shift+A)">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Opacity="0.35" />
                                            <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- Trace toolbar. The notch becomes the tool picker while
                         an area is being marked out, so there is no second window
                         competing with the thing the user is trying to look at. -->
                    <StackPanel x:Name="TraceTools" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- The three tools have to be told apart at a glance, so
                             they differ on two axes at once: dashed vs solid, and
                             round vs square vs open corners. An irregular dashed
                             loop is the marching-ants idiom for a free selection. -->
                        <Border x:Name="ToolFreehand" Tag="Freehand" Style="{StaticResource TraceToolButton}"
                                MouseLeftButtonUp="TraceTool_OnClick" ToolTip="Draw around an area">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Path Style="{StaticResource TraceToolIcon}"
                                  StrokeDashArray="2.2 1.7"
                                  Data="M 8,2.7 C 11.3,2.5 14,4.7 13.9,7.7 C 13.8,10.7 11.1,13.3 7.8,13.3
                                        C 4.5,13.3 2.1,11 2.1,7.9 C 2.1,4.8 4.7,2.9 8,2.7 Z" />
                        </Border>
                        <Border x:Name="ToolRectangle" Tag="Rectangle" Style="{StaticResource TraceToolButton}"
                                MouseLeftButtonUp="TraceTool_OnClick" ToolTip="Drag a rectangle">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Path Style="{StaticResource TraceToolIcon}"
                                  Data="M 2.6,3.7 L 13.4,3.7 L 13.4,12.3 L 2.6,12.3 Z" />
                        </Border>
                        <!-- Four corner brackets: the standard way to say "all of
                             it" without drawing a filled shape that would read as a
                             solid selection. -->
                        <Border x:Name="ToolFullScreen" Tag="FullScreen" Style="{StaticResource TraceToolButton}"
                                MouseLeftButtonUp="TraceTool_OnClick" ToolTip="Use the whole screen">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Path Style="{StaticResource TraceToolIcon}"
                                  Data="M 2.6,6.2 L 2.6,2.6 L 6.2,2.6   M 9.8,2.6 L 13.4,2.6 L 13.4,6.2
                                        M 13.4,9.8 L 13.4,13.4 L 9.8,13.4   M 6.2,13.4 L 2.6,13.4 L 2.6,9.8" />
                        </Border>

                        <Border x:Name="ToolDivider" Width="1" Height="16" Background="{DynamicResource NotchDividerBrush}" Margin="8,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        </Border>

                        <Border x:Name="ToolAsk" Width="46" Style="{StaticResource TraceToolButton}"
                                MouseLeftButtonUp="TraceAsk_OnClick" ToolTip="Ask about this area">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <TextBlock Text="Ask" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusListeningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ToolCancel" Style="{StaticResource TraceToolButton}"
                                MouseLeftButtonUp="TraceCancel_OnClick" ToolTip="Cancel">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Path Style="{StaticResource TraceToolIcon}" Stroke="{DynamicResource NotchDangerInkBrush}"
                                  Data="M 4.6,4.6 L 11.4,11.4   M 11.4,4.6 L 4.6,11.4" />
                        </Border>
                    </StackPanel>

                    <!-- Hover affordances: pull-down chevron and a settings gear.
                         Only shown on hover so the resting notch stays quiet. -->
                    <StackPanel x:Name="HoverControls" Orientation="Horizontal" Opacity="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="Chevron" Text="⌄" FontSize="15" Foreground="{DynamicResource NotchChromeBrush}"
                                   Margin="0,-3,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource NotchChromeBrush}" VerticalAlignment="Center"
                                   Cursor="Hand" ToolTip="Metis setup"
                                   MouseLeftButtonUp="Settings_OnMouseLeftButtonUp" />
                    </StackPanel>
                </Grid>

                <!--
                    One scroller for the whole shell, rather than one per page.

                    Before this the body clipped at a hard 520 pixels and
                    nothing scrolled, so a page taller than that did not
                    overflow — it was simply cut off and unreachable. That was
                    tolerable when the notch held a chat; it is not now that
                    settings live here, where the provider page alone measures
                    about fourteen hundred.

                    Because the scroller sits outside the pages, each page still
                    reports its own natural height and the shell decides what to
                    do about it. No page had to change.

                    The chat is the deliberate exception: it wants a pinned
                    composer above a scrolling transcript, and it already has its
                    own scroller for the transcript. Nesting one inside another
                    is the classic wheel-capture trap, so the shell's scroller is
                    switched off while the chat is showing. That rule is stated
                    here and nowhere else.
                -->
                <ScrollViewer x:Name="PageScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Top"
                              Focusable="False"
                              PanningMode="VerticalOnly"
                              ScrollChanged="PageScroll_OnScrollChanged">
                    <Grid x:Name="PageHost">
                        <!-- The chat. Collapsed rather than hidden while the notch is
                             resting, so it costs no layout until it is asked for. -->
                        <windows:NotchChat x:Name="ChatHost" VerticalAlignment="Top"
                                           Visibility="Collapsed" Opacity="0" Cursor="Arrow" />

                        <!-- First run: sign in, then what Metis is. Collapsed on the
                             same terms as the chat, and only ever shown instead of it —
                             the two are never open at once. -->
                        <windows:NotchAuth x:Name="AuthHost" VerticalAlignment="Top"
                                           Visibility="Collapsed" Opacity="0" Cursor="Arrow" />

                        <!-- Autonomous background agents drawer -->
                        <windows:NotchAgentDrawer x:Name="AgentDrawerHost" VerticalAlignment="Top"
                                                  Visibility="Collapsed" Opacity="0" Cursor="Arrow" />

                        <!-- First run. Four steps in the place people will
                             be using afterwards, rather than in a wizard
                             window they close and never see again. -->
                        <windows:NotchWelcome x:Name="WelcomeHost" VerticalAlignment="Top"
                                              Visibility="Collapsed" Opacity="0" Cursor="Arrow" />

                        <!-- Settings. The account, the plan, and what Metis
                             is called — in the one place people already know
                             where to look, rather than in a window that opened
                             from a tray menu most of them never found. -->
                        <windows:NotchSettings x:Name="SettingsHost" VerticalAlignment="Top"
                                               Visibility="Collapsed" Opacity="0" Cursor="Arrow" />

                        <!-- Autonomous background agent spawn panel -->
                        <windows:NotchSpawnAgentPanel x:Name="SpawnAgentHost" VerticalAlignment="Top"
                                                      Visibility="Collapsed" Opacity="0" Cursor="Arrow" />
                    </Grid>
                </ScrollViewer>

                <!-- The "there is more below" edge.
                     A page taller than the screen scrolls, and the row it cuts
                     through used to be cut dead flat — which reads as a broken
                     window rather than as a list continuing. Fading the last
                     fourteen pixels into the notch's own colour says the same
                     thing the scrollbar says, to the people who do not look at
                     scrollbars. Hit-test invisible so it cannot eat a click on
                     whatever it is sitting over, and shown only while there is
                     actually something below. -->
                <Border x:Name="ScrollEdge" Height="14" VerticalAlignment="Bottom"
                        Margin="10,0,10,0" IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Background="{DynamicResource NotchScrollEdgeBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
