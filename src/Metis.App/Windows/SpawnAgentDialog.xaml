<Window x:Class="Metis.App.Windows.SpawnAgentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spawn Background Agent"
        Width="480" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogInk" Color="#F2F2F7" />
        <SolidColorBrush x:Key="DialogMuted" Color="#8E8E93" />
        <SolidColorBrush x:Key="DialogSurface" Color="#16161A" />
        <SolidColorBrush x:Key="DialogField" Color="#1F1F24" />
        <SolidColorBrush x:Key="DialogAccent" Color="#0A7CFF" />

        <Style x:Key="DialogButton" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource DialogAccent}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplatePill" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DialogSurface}" CornerRadius="16" BorderBrush="#2C2C33" BorderThickness="1"
            Padding="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Spawn Background Agent" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource DialogInk}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="24" Height="24" CornerRadius="12" Background="#1AFFFFFF" HorizontalAlignment="Right"
                        Cursor="Hand" MouseLeftButtonUp="Cancel_OnClick">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource DialogMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Preset Templates -->
            <StackPanel Grid.Row="1" Margin="0,14,0,10">
                <TextBlock Text="TEMPLATES / QUICK STARTS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogMuted}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Border Style="{StaticResource TemplatePill}" Tag="Organize files in Downloads by extension and type"
                            MouseLeftButtonUp="Template_OnClick">
                        <TextBlock Text="📁 Organize Downloads" FontSize="11" Foreground="{StaticResource DialogInk}" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource TemplatePill}" Tag="Research the latest AI breakthroughs this week and compile a markdown summary"
                            MouseLeftButtonUp="Template_OnClick">
                        <TextBlock Text="🌐 Web Research &amp; Report" FontSize="11" Foreground="{StaticResource DialogInk}" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource TemplatePill}" Tag="Find all error logs on the system and summarize recent crashes"
                            MouseLeftButtonUp="Template_OnClick">
                        <TextBlock Text="💻 System Log Analysis" FontSize="11" Foreground="{StaticResource DialogInk}" VerticalAlignment="Center" />
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Goal Input -->
            <Grid Grid.Row="2" Margin="0,4,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="WHAT SHOULD THE AGENT DO?" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogMuted}" Margin="0,0,0,6" />
                <Border Grid.Row="1" Background="{StaticResource DialogField}" CornerRadius="10" BorderBrush="#2C2C33" BorderThickness="1"
                        Padding="10,8">
                    <TextBox x:Name="GoalBox" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource DialogInk}" FontSize="13"
                             CaretBrush="{StaticResource DialogInk}" VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

            <!-- Working Directory -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="WORKING DIRECTORY (OPTIONAL)" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource DialogMuted}" Margin="0,0,0,4" />
                <Border Background="{StaticResource DialogField}" CornerRadius="8" BorderBrush="#2C2C33" BorderThickness="1"
                        Padding="8,6">
                    <TextBox x:Name="WorkingDirBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource DialogInk}" FontSize="11.5" CaretBrush="{StaticResource DialogInk}" />
                </Border>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <TextBlock Text="Agent runs in background without cursor takeover" FontSize="10.5"
                           Foreground="{StaticResource DialogMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource DialogButton}" Background="#1AFFFFFF" Margin="0,0,8,0"
                            MouseLeftButtonUp="Cancel_OnClick">
                        <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DialogInk}" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource DialogButton}" MouseLeftButtonUp="Spawn_OnClick">
                        <TextBlock Text="Spawn Agent" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
