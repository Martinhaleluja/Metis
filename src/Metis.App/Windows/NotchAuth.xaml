<UserControl x:Class="Metis.App.Windows.NotchAuth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- The first thing anyone sees of Metis. It lives inside the notch body,
         which keeps its own colours in every theme because it hangs over
         whatever the user is working in, so every colour here is a literal
         rather than a theme token - the same rule NotchChat follows. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AuthInk" Color="#F2F2F7" />
        <SolidColorBrush x:Key="AuthMuted" Color="#8E8E93" />
        <SolidColorBrush x:Key="AuthFaint" Color="#5A5A61" />
        <SolidColorBrush x:Key="AuthField" Color="#17171B" />
        <SolidColorBrush x:Key="AuthFieldEdge" Color="#2C2C33" />
        <SolidColorBrush x:Key="AuthAccent" Color="#0A7CFF" />
        <SolidColorBrush x:Key="AuthDangerInk" Color="#FF6257" />
        <SolidColorBrush x:Key="AuthGoodInk" Color="#30D158" />
        <SolidColorBrush x:Key="AuthHairline" Color="#1F1F24" />

        <Style x:Key="AuthFieldBed" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AuthField}" />
            <Setter Property="BorderBrush" Value="{StaticResource AuthFieldEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="38" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- A filled pill for the one action the panel is asking for. -->
        <Style x:Key="AuthPrimary" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AuthAccent}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B8DFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ======================= Sign in / sign up ======================= -->
        <StackPanel x:Name="AuthPage" Margin="26,20,26,20">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Ellipse x:Name="MarkHalo" Width="22" Height="22"
                             Fill="{StaticResource AuthAccent}" Opacity="0.22" />
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AuthAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="Heading" Text="Sign in to Metis" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource AuthInk}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="Subheading" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource AuthMuted}" Margin="0,0,0,16"
                       Text="Your account is what lets Metis remember what you have learned." />

            <!-- Email -->
            <Border Style="{StaticResource AuthFieldBed}" Margin="0,0,0,9">
                <Grid>
                    <TextBlock x:Name="EmailPlaceholder" Text="Email address" Margin="13,0" FontSize="13"
                               IsHitTestVisible="False" Foreground="{StaticResource AuthFaint}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="EmailBox" BorderThickness="0" Background="Transparent"
                             Padding="12,0" FontSize="13" VerticalContentAlignment="Center"
                             Foreground="{StaticResource AuthInk}"
                             CaretBrush="{StaticResource AuthInk}"
                             SelectionBrush="{StaticResource AuthAccent}"
                             TextChanged="EmailBox_OnTextChanged"
                             PreviewKeyDown="Field_OnPreviewKeyDown" />
                </Grid>
            </Border>

            <!-- Password. A PasswordBox rather than a TextBox, so the value
                 never lands in a property that something else could read. -->
            <Border Style="{StaticResource AuthFieldBed}" Margin="0,0,0,4">
                <Grid>
                    <TextBlock x:Name="PasswordPlaceholder" Text="Password" Margin="13,0" FontSize="13"
                               IsHitTestVisible="False" Foreground="{StaticResource AuthFaint}"
                               VerticalAlignment="Center" />
                    <PasswordBox x:Name="PasswordField" BorderThickness="0" Background="Transparent"
                                 Padding="12,0" FontSize="13" VerticalContentAlignment="Center"
                                 Foreground="{StaticResource AuthInk}"
                                 CaretBrush="{StaticResource AuthInk}"
                                 SelectionBrush="{StaticResource AuthAccent}"
                                 PasswordChanged="PasswordField_OnChanged"
                                 PreviewKeyDown="Field_OnPreviewKeyDown" />
                </Grid>
            </Border>

            <TextBlock x:Name="PasswordHint" FontSize="10" Margin="2,0,0,0"
                       Foreground="{StaticResource AuthFaint}"
                       Text="At least eight characters." Visibility="Collapsed" />

            <Border x:Name="PrimaryButton" Style="{StaticResource AuthPrimary}" Margin="0,12,0,0"
                    MouseLeftButtonUp="Primary_OnClick">
                <Grid>
                    <TextBlock x:Name="PrimaryLabel" Text="Sign in" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- The working state. A ring that spins rather than a label
                         that changes, so the button keeps its size and the
                         panel does not jump while the network is slow. -->
                    <Ellipse x:Name="Spinner" Width="15" Height="15" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="White" StrokeThickness="1.8"
                             StrokeDashArray="2.6 1.4" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerTurn" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusLine" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,11,0,0" Foreground="{StaticResource AuthMuted}"
                       Visibility="Collapsed" />

            <Border Height="1" Background="{StaticResource AuthHairline}" Margin="0,15,0,12" />

            <TextBlock HorizontalAlignment="Center" FontSize="11.5">
                <Run x:Name="SwitchPrompt" Text="New to Metis?" Foreground="#8E8E93" />
                <Hyperlink Click="Switch_OnClick" Foreground="{StaticResource AuthAccent}"
                           TextDecorations="{x:Null}">
                    <Run x:Name="SwitchAction" Text="Create an account" />
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="Built by Martin Nakasole" FontSize="10" TextAlignment="Center"
                       Margin="0,14,0,0" Foreground="{StaticResource AuthFaint}" />
        </StackPanel>

        <!-- ==================== About and permissions ==================== -->
        <StackPanel x:Name="WelcomePage" Margin="24,20,24,20" Visibility="Collapsed">
            <TextBlock x:Name="WelcomeHeading" Text="Welcome to Metis" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource AuthInk}" HorizontalAlignment="Center" />

            <TextBlock FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" Margin="6,6,6,15"
                       Foreground="{StaticResource AuthMuted}"
                       Text="Metis teaches. When you ask, it looks at what is on your screen, then explains and draws over the top - arrows, outlines, a pointer that traces the path. It never takes control of your computer." />

            <TextBlock Text="WHAT METIS NEEDS" FontSize="9" FontWeight="Bold" Margin="3,0,0,7"
                       Foreground="{StaticResource AuthFaint}" />

            <!-- Rows are built in code so they can be staggered in, and so each
                 one carries the setting it actually toggles. -->
            <StackPanel x:Name="PermissionRows" />

            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="3,12,3,0"
                       Foreground="{StaticResource AuthFaint}"
                       Text="All of these can be changed later in Setup. Metis looks at your screen only for the request you asked about." />

            <Border x:Name="ContinueButton" Style="{StaticResource AuthPrimary}" Margin="0,17,0,0"
                    MouseLeftButtonUp="Continue_OnClick">
                <TextBlock Text="Start using Metis" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
