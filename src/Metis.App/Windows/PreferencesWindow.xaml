<Window x:Class="Metis.App.Windows.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metis Preferences"
        Width="980" Height="700" MinWidth="860" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.InputBindings>
        <!-- The old Setup footer advertised both of these and implemented
             neither. -->
        <KeyBinding Key="K" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_OnExecuted" />
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Close_OnExecuted" />
    </Window.CommandBindings>

    <Border Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusWindow}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="7" Opacity="0.2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    CornerRadius="12,12,0,0" Padding="18,0" Height="56"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"
                              Fill="{DynamicResource AccentBrush}"
                              Data="M34,8 C42,-1 56,-1 64,7 C72,15 72,27 66,35 C72,43 72,55 64,63 C56,71 44,71 35,65 C27,71 15,71 7,63 C-1,55 -1,43 5,35 C-1,27 -1,15 7,7 C15,-1 27,-1 34,8 Z" />
                        <TextBlock Text="Metis" Style="{StaticResource WordmarkText}" FontSize="17"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="PREFERENCES" Style="{StaticResource MonoLabelText}"
                                   Margin="10,3,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="260" Height="30"
                            Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusField}">
                        <Grid>
                            <!-- WPF has no placeholder, so this sits behind the
                                 field and is hidden as soon as anything is
                                 typed. Without it the search reads as an empty
                                 unexplained pill. -->
                            <TextBlock x:Name="SearchHint" Text="Search settings   Ctrl+K"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" IsHitTestVisible="False"
                                       Foreground="{DynamicResource FaintBrush}" />
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     Padding="11,0,10,0" FontSize="12" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_OnTextChanged"
                                     ToolTip="Search settings (Ctrl+K)" />
                        </Grid>
                    </Border>
                    <Button Content="✕" Style="{StaticResource ChromeButton}"
                            HorizontalAlignment="Right" ToolTip="Close (Esc)" Click="Close_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14">
                        <StackPanel x:Name="NavPanel" />
                    </ScrollViewer>
                </Border>

                <!-- Pages -->
                <ScrollViewer Grid.Column="1" x:Name="PageScroll"
                              VerticalScrollBarVisibility="Auto" Padding="30,26,30,26">
                    <Grid>
                        <!-- ============ Dashboard ============ -->
                        <StackPanel x:Name="PageDashboard">
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Everything Metis is doing right now, and where to change it." />

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource UtilityCard}" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="WHAT METIS DOES" />
                                        <TextBlock x:Name="DashModeText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="DashModeSummary" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
                                        <Button Content="Screen and privacy" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Tag="Privacy" Click="Jump_OnClick" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource UtilityCard}" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="THINKING WITH" />
                                        <TextBlock x:Name="DashProviderText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="DashProviderDetail" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
                                        <Button Content="Change" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Tag="Intelligence" Click="Jump_OnClick" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource UtilityCard}" Margin="0,0,8,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="SCREEN ACCESS" />
                                        <TextBlock x:Name="DashCaptureText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="DashCaptureDetail" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
                                        <Button Content="Review" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Tag="Privacy" Click="Jump_OnClick" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource UtilityCard}" Margin="8,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="VOICE" />
                                        <TextBlock x:Name="DashVoiceText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" />
                                        <TextBlock x:Name="DashVoiceDetail" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
                                        <Button Content="Change" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Tag="Voice" Click="Jump_OnClick" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,4,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="WHAT YOU HAVE LEARNED" />
                                    <TextBlock x:Name="LearningSummary" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                    <ItemsControl x:Name="LearningList" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SHORTCUTS" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl+Shift+1 / Ctrl+Shift+A" />
                                            </Border>
                                            <TextBlock Text="Hold to talk · Spawn voice agent" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl+Alt" />
                                            </Border>
                                            <TextBlock Text="Ask about the screen (Context)" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl+Alt+Shift" />
                                            </Border>
                                            <TextBlock Text="Point at something" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <TextBlock Style="{StaticResource KeycapText}" Text="Ctrl+Space" />
                                            </Border>
                                            <TextBlock Text="Continuous listen" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource KeycapChip}">
                                                <TextBlock Style="{StaticResource KeycapText}" Text="F12" />
                                            </Border>
                                            <TextBlock Text="Stop guidance &amp; agents" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ General ============ -->
                        <StackPanel x:Name="PageAccount" Visibility="Collapsed">
                            <TextBlock Text="Account &amp; plan" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Who you are signed in as, and what that includes." />

                            <!-- The plan. Read-only on purpose: anything that
                                 costs money happens on the website, where a
                                 payment page belongs, and this button opens it. -->
                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border x:Name="AccountPlanBadge" Style="{StaticResource Badge}">
                                        <TextBlock x:Name="AccountPlanBadgeText" Style="{StaticResource BadgeText}" Text="FREE" />
                                    </Border>
                                    <TextBlock x:Name="AccountPlanTitle" Style="{StaticResource SubtitleText}" Margin="0,12,0,0"
                                               Text="Not signed in" />
                                    <TextBlock x:Name="AccountPlanDetail" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="Metis works fully without an account, on your own API key or a local model." />

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="AccountManageButton" Content="Manage plan on the web"
                                                Click="AccountManage_OnClick" />
                                        <Button x:Name="AccountSignInButton" Content="Sign in" Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="AccountSignIn_OnClick" />
                                        <Button x:Name="AccountSignOutButton" Content="Sign out" Margin="8,0,0,0"
                                                Style="{StaticResource QuietButton}"
                                                Click="AccountSignOut_OnClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- This month's allowance. Only meaningful for the
                                 AI Metis pays for; turns on the user's own key
                                 are never counted here because they never reach
                                 a Metis server at all. -->
                            <Border x:Name="AccountUsageCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="INCLUDED AI THIS MONTH" />
                                    <TextBlock x:Name="AccountUsageText" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"
                                               Text="Nothing used yet" />
                                    <Border Margin="0,10,0,0" Height="8" CornerRadius="4"
                                            Background="{DynamicResource TrackFillBrush}">
                                        <Border x:Name="AccountUsageFill" HorizontalAlignment="Left" Width="0"
                                                CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock x:Name="AccountUsageDetail" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- What the plan includes, straight from the
                                 server's own answer rather than from a list
                                 written twice. -->
                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="WHAT THIS PLAN INCLUDES" />
                                    <ItemsControl x:Name="AccountFeatureList" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,5"
                                                           TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="AccountFeatureNote" Style="{StaticResource CaptionText}"
                                               Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                            <TextBlock Text="General" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Startup, appearance, and sounds." />

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="YOUR NAME" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,8"
                                               Text="What Metis should call you when speaking or guiding." />
                                    <TextBox x:Name="UserNameBox" Margin="0,0,0,0" ToolTip="Enter your name" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="STARTUP" />
                                    <CheckBox x:Name="StartWithWindowsCheck" Margin="0,12,0,0"
                                              Content="Start Metis when I sign in to Windows" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="APPEARANCE" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Follow Windows"
                                                     Margin="0,0,20,0" Checked="Theme_OnChanged" />
                                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light"
                                                     Margin="0,0,20,0" Checked="Theme_OnChanged" />
                                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark"
                                                     Checked="Theme_OnChanged" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Separator}" />
                                    <CheckBox x:Name="ReduceMotionCheck"
                                              Content="Reduce motion in the companion and window animations" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SOUNDS" />
                                    <CheckBox x:Name="ActivationSoundsCheck" Margin="0,12,0,12"
                                              Content="Play a cue when Metis starts and stops listening" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="Sound pack folder" />
                                    <TextBox x:Name="SoundPackPathBox" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                                               Text="Leave empty to use the built-in cues." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Intelligence ============ -->
                        <StackPanel x:Name="PageIntelligence" Visibility="Collapsed">
                            <TextBlock Text="Intelligence" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Which model does the thinking, and how to reach it." />

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="PROVIDER" />
                                    <ComboBox x:Name="ProviderBox" Margin="0,10,0,0" Width="240"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="ProviderBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Gemini" />
                                        <!-- Metis's own AI. Only offered when
                                             signed in: without an account there
                                             is no plan for it to draw on, and a
                                             choice that cannot work is worse
                                             than one that is absent. -->
                                        <ComboBoxItem x:Name="MetisProviderItem" Content="Metis" Visibility="Collapsed" />
                                        <ComboBoxItem Content="OpenAI" />
                                        <ComboBoxItem Content="Claude" />
                                        <ComboBoxItem Content="OpenRouter" />
                                        <ComboBoxItem Content="OpenClaw" />
                                        <ComboBoxItem Content="Ollama" />
                                        <ComboBoxItem Content="Automatic" />
                                    </ComboBox>
                                    <TextBlock x:Name="ProviderHint" Style="{StaticResource CaptionText}" Margin="2,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Use fully local preset" Style="{StaticResource SecondaryButton}"
                                                Click="LocalPreset_OnClick" />
                                        <Button Content="Test" Margin="8,0,0,0" Click="TestProvider_OnClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="ProviderStatus" Style="{StaticResource CaptionText}" Margin="2,10,0,0" />
                                    <TextBlock x:Name="ProviderPlanNote" Style="{StaticResource CaptionText}"
                                               Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GeminiCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="GEMINI" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="API key" />
                                    <PasswordBox x:Name="GeminiApiKeyBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Model" />
                                    <TextBox x:Name="GeminiModelBox" />
                                    <Button Content="Remove stored key" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Tag="Gemini" Click="RemoveKey_OnClick" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="MetisCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="METIS" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="There is no key to enter. Metis answers on its own provider account, within the monthly allowance your plan includes, and the model is chosen from what that plan allows." />
                                    <TextBlock x:Name="MetisPlanSummary" Style="{StaticResource CaptionText}"
                                               Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <Button Content="See your plan and usage" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Tag="Account" Click="Jump_OnClick" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="OpenAiCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="OPENAI" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="API key" />
                                    <PasswordBox x:Name="OpenAiApiKeyBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Model" />
                                    <TextBox x:Name="OpenAiModelBox" />
                                    <Button Content="Remove stored key" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Tag="OpenAI" Click="RemoveKey_OnClick" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ClaudeCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="CLAUDE" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="API key" />
                                    <PasswordBox x:Name="ClaudeApiKeyBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Model" />
                                    <TextBox x:Name="ClaudeModelBox" />
                                    <Button Content="Remove stored key" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Tag="Claude" Click="RemoveKey_OnClick" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="OpenRouterCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="OPENROUTER" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="API key" />
                                    <PasswordBox x:Name="OpenRouterApiKeyBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4"
                                               Text="Model — use Find models to list the vision-capable ones" />
                                    <TextBox x:Name="OpenRouterModelBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Endpoint" />
                                    <TextBox x:Name="OpenRouterEndpointBox" />
                                    <Border Style="{StaticResource Separator}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="Free models ending in :free cost nothing but are capped at roughly 20 requests a minute, and 50 a day until the account has ever held credit. Metis sends a screenshot with every question, so that allowance goes quickly." />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="Privacy: many free models are served by providers that may log or train on what they receive — for Metis that means pictures of your screen. Set a stricter data policy in your OpenRouter account, or use Ollama for work that must stay private." />
                                    <Button Content="Remove stored key" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Tag="OpenRouter" Click="RemoveKey_OnClick" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="OpenClawCard" Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="OPENCLAW GATEWAY" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Endpoint" />
                                    <TextBox x:Name="OpenClawEndpointBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Model" />
                                    <TextBox x:Name="OpenClawModelBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Token (optional)" />
                                    <PasswordBox x:Name="OpenClawTokenBox" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="OllamaCard" Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="OLLAMA" />
                                    </Border>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Endpoint" />
                                    <TextBox x:Name="OllamaEndpointBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4" Text="Model" />
                                    <TextBox x:Name="OllamaModelBox" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,4"
                                               Text="Context tokens (2048–4096)" />
                                    <TextBox x:Name="LocalContextTokensBox" Width="120" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Modes ============ -->
                        <!-- ============ Voice ============ -->
                        <StackPanel x:Name="PageVoice" Visibility="Collapsed">
                            <TextBlock Text="Voice &amp; input" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="How Metis hears you, and how it speaks back." />

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="MICROPHONE" />
                                    <ComboBox x:Name="MicrophoneBox" Margin="0,10,0,0" />
                                    <TextBlock x:Name="MicrophoneStatus" Style="{StaticResource CaptionText}" Margin="2,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SPEECH TO TEXT" />
                                    <ComboBox x:Name="SpeechToTextProviderBox" Margin="0,10,0,0" Width="240"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="SpeechProvider_OnSelectionChanged">
                                        <ComboBoxItem Content="Native" />
                                        <ComboBoxItem Content="Whisper.cpp" />
                                        <ComboBoxItem Content="AssemblyAI" />
                                    </ComboBox>
                                    <StackPanel x:Name="WhisperPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="whisper-cli.exe" />
                                        <TextBox x:Name="WhisperCppExecutablePathBox" Margin="0,6,0,10" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="GGML model" />
                                        <TextBox x:Name="WhisperCppModelPathBox" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="AssemblyAiPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="AssemblyAI key" />
                                        <PasswordBox x:Name="AssemblyAiApiKeyBox" Margin="0,6,0,10" />
                                         <TextBlock Style="{StaticResource CaptionText}" Text="Model" />
                                         <ComboBox x:Name="AssemblyAiModelBox" Margin="0,6,0,0" IsEditable="True">
                                             <ComboBoxItem Content="best" ToolTip="Best Accuracy (Standard/Paid)" />
                                             <ComboBoxItem Content="nano" ToolTip="Nano Model (Low Cost / Free Tier)" />
                                             <ComboBoxItem Content="universal-2" ToolTip="Universal-2 Model (Legacy)" />
                                         </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="NativeSttPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="OpenAI transcription model" />
                                        <TextBox x:Name="OpenAiTranscriptionModelBox" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="TEXT TO SPEECH" />
                                    <ComboBox x:Name="TextToSpeechProviderBox" Margin="0,10,0,0" Width="240"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="SpeechProvider_OnSelectionChanged">
                                        <ComboBoxItem Content="Native" />
                                        <ComboBoxItem Content="Piper" />
                                        <ComboBoxItem Content="Chatterbox-Nano" />
                                        <ComboBoxItem Content="ElevenLabs" />
                                    </ComboBox>

                                    <StackPanel x:Name="NativeTtsPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="GEMINI NATIVE VOICE (RECOMMENDED · FREE TIER)" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="Natural, ultra-fast speech synthesis included free with Gemini 2.0 / 2.5 Flash on Google AI Studio keys."
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <TextBlock Style="{StaticResource CaptionText}" Text="Gemini voice" />
                                        <ComboBox x:Name="GeminiVoiceBox" Margin="0,4,0,10" Width="330" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Kore — Clear, soothing &amp; balanced (Female · Recommended)" Tag="Kore" />
                                            <ComboBoxItem Content="Puck — Energetic, animated &amp; youthful (Male)" Tag="Puck" />
                                            <ComboBoxItem Content="Charon — Deep, calm &amp; resonant (Male)" Tag="Charon" />
                                            <ComboBoxItem Content="Fenrir — Strong, confident &amp; dynamic (Male)" Tag="Fenrir" />
                                            <ComboBoxItem Content="Aoede — Warm, expressive &amp; melodic (Female)" Tag="Aoede" />
                                        </ComboBox>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                            <Button x:Name="GeminiVoicePreviewButton" Content="Preview Gemini voice" Style="{StaticResource SecondaryButton}" Click="GeminiVoicePreview_OnClick" />
                                            <TextBlock x:Name="GeminiVoicePreviewStatus" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>

                                        <Border Style="{StaticResource Separator}" Margin="0,4,0,12" />

                                        <TextBlock Style="{StaticResource MonoLabelText}" Text="OPENAI VOICE &amp; MODEL" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="OpenAI voice" />
                                        <ComboBox x:Name="OpenAiVoiceBox" Margin="0,4,0,10" Width="330" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="alloy — Neutral &amp; balanced" Tag="alloy" />
                                            <ComboBoxItem Content="echo — Warm &amp; rounded" Tag="echo" />
                                            <ComboBoxItem Content="fable — Expressive British tone" Tag="fable" />
                                            <ComboBoxItem Content="onyx — Deep &amp; authoritative" Tag="onyx" />
                                            <ComboBoxItem Content="nova — Energetic &amp; bright" Tag="nova" />
                                            <ComboBoxItem Content="shimmer — Clear &amp; calm" Tag="shimmer" />
                                        </ComboBox>

                                        <TextBlock Style="{StaticResource CaptionText}" Text="OpenAI speech model" />
                                        <ComboBox x:Name="OpenAiSpeechModelBox" Margin="0,4,0,6" Width="330" HorizontalAlignment="Left" IsEditable="True">
                                            <ComboBoxItem Content="tts-1 (Standard)" Tag="tts-1" />
                                            <ComboBoxItem Content="tts-1-hd (High Definition)" Tag="tts-1-hd" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="PiperPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="piper.exe" />
                                        <TextBox x:Name="PiperExecutablePathBox" Margin="0,6,0,10" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Voice model (.onnx)" />
                                        <TextBox x:Name="PiperVoiceModelPathBox" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ChatterboxPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Endpoint (loopback only)" />
                                        <TextBox x:Name="ChatterboxEndpointBox" Margin="0,6,0,10" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Model / voice" />
                                        <TextBox x:Name="ChatterboxModelBox" Margin="0,6,0,6" />
                                        <TextBox x:Name="ChatterboxVoiceBox" />
                                    </StackPanel>
                                    <StackPanel x:Name="ElevenLabsPanel" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource CaptionText}" Text="ElevenLabs key" />
                                        <PasswordBox x:Name="ElevenLabsApiKeyBox" Margin="0,6,0,10" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="Model / voice id" />
                                        <TextBox x:Name="ElevenLabsModelBox" Margin="0,6,0,6" />
                                        <TextBox x:Name="ElevenLabsVoiceIdBox" />
                                    </StackPanel>

                                    <Border Style="{StaticResource Separator}" />
                                    <CheckBox x:Name="SpeechEnabledCheck" Margin="0,0,0,12"
                                              Content="Speak answers out loud" />
                                    <CheckBox x:Name="SpeakErrorsCheck"
                                              Content="Speak errors aloud with the offline Piper voice" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Companion ============ -->
                        <StackPanel x:Name="PageCompanion" Visibility="Collapsed">
                            <TextBlock Text="Companion" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Changes here save and apply immediately." />
                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="RESTING COLOUR" />
                                    <ItemsControl x:Name="ColourSwatches" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                                               Text="Only the resting colour is yours to pick. The listening, thinking, and error colours carry meaning and stay fixed." />

                                    <Border Style="{StaticResource Separator}" />

                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SHAPE" />
                                    <ItemsControl x:Name="ShapeChoices" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="ShapeCaption" Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                                               Text="The shape is only a look. Every form does everything the companion already does." />

                                    <Border Style="{StaticResource Separator}" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Size" VerticalAlignment="Center" />
                                        <Slider x:Name="CompanionSizeSlider" Grid.Column="1" Minimum="32" Maximum="112"
                                                VerticalAlignment="Center" />
                                        <TextBlock x:Name="CompanionSizeValue" Grid.Column="2" Width="44"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cursor distance" VerticalAlignment="Center" />
                                        <Slider x:Name="CursorDistanceSlider" Grid.Column="1" Minimum="0" Maximum="120"
                                                VerticalAlignment="Center" />
                                        <TextBlock x:Name="CursorDistanceValue" Grid.Column="2" Width="44"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Privacy ============ -->
                        <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
                            <TextBlock Text="Memory &amp; privacy" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="What Metis sees, what it keeps, and how to erase it." />

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SCREEN" />
                                    <CheckBox x:Name="CaptureScreenCheck" Margin="0,12,0,0"
                                              Content="Let Metis capture the screen when I ask it something" />
                                    <TextBlock x:Name="CaptureDisclosure" Style="{StaticResource CaptionText}" Margin="48,8,0,0" />
                                    <Border Style="{StaticResource Separator}" />
                                    <CheckBox x:Name="VisualGuidanceCheck" Margin="0,0,0,12"
                                              Content="Draw arrows and highlights over the desktop" />
                                    <CheckBox x:Name="ContextShortcutsCheck"
                                              Content="Enable the Ctrl+Alt screen shortcuts" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="48,8,0,0"
                                               Text="Metis draws over the screen to point things out. The marks are click-through and fade on their own; it never takes the pointer or types for you." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="NEVER LOOK AT" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                               Text="One app per line, by its name or a piece of its window title. Anything matching is painted out of the screenshot before it is sent, and Metis is told a region was withheld so it does not guess." />
                                    <TextBox x:Name="ExcludedAppsBox" Margin="0,12,0,0" Height="92"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               Text="Apps that mark themselves private — banking apps, password managers, view-once photos in WhatsApp and Signal — are already hidden from Metis without being listed here. Password boxes are never read." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="WHAT IS KEPT" />
                                    <CheckBox x:Name="MemoryEnabledCheck" Margin="0,12,0,12"
                                              Content="Remember which steps I have already learned" />
                                    <CheckBox x:Name="ChatMemoryCheck"
                                              Content="Keep conversations between runs" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="48,8,0,0"
                                               Text="Recall only ever quotes your own last two lines from an earlier chat, never Metis's replies." />
                                    <Border Style="{StaticResource Separator}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Clear memory" Style="{StaticResource DangerButton}"
                                                Click="ClearMemory_OnClick" />
                                        <Button Content="Clear chat history" Style="{StaticResource DangerButton}"
                                                Margin="10,0,0,0" Click="ClearChats_OnClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="PrivacyStatus" Style="{StaticResource CaptionText}" Margin="2,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Skills ============ -->
                        <StackPanel x:Name="PageSkills" Visibility="Collapsed">
                            <TextBlock Text="Skills" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Markdown notes you write about your own software." />
                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <CheckBox x:Name="UserSkillsCheck" Content="Use my skill notes" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,14,0,4" Text="Skills folder" />
                                    <TextBox x:Name="SkillsFolderBox" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Open folder" Style="{StaticResource SecondaryButton}"
                                                Click="OpenSkills_OnClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="SkillsStatus" Style="{StaticResource CaptionText}" Margin="2,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Diagnostics ============ -->
                        <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">
                            <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Live state, read from the running app." />
                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <ItemsControl x:Name="DiagnosticsList" />
                                    <Border Style="{StaticResource Separator}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                                Click="RefreshDiagnostics_OnClick" />
                                        <Button Content="Open logs" Style="{StaticResource SecondaryButton}"
                                                Margin="10,0,0,0" Click="OpenLogs_OnClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Updates ============ -->
                        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                            <TextBlock Text="Updates" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Keep Metis up to date with the latest features, models, and improvements." />
                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="APPLICATION VERSION" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="CurrentVersionLabel" Text="Metis"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionText}"
                                                       Margin="0,4,0,0" Text="Click check for updates to query GitHub for new releases." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="CheckUpdates_OnClick" />
                                            <Button x:Name="InstallUpdateButton" Content="Update &amp; restart"
                                                    Margin="10,0,0,0" Visibility="Collapsed"
                                                    Click="InstallUpdate_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Separator}" />
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="AUTOMATIC UPDATES" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               Text="Metis checks for updates in the background on startup and notifies you in the notch. When you click update, it updates seamlessly in 2 seconds and restarts with all your accounts, API keys, and settings preserved." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Autonomous Agents ============ -->
                        <StackPanel x:Name="PageAgents" Visibility="Collapsed">
                            <TextBlock Text="Autonomous Agents" Style="{StaticResource PageTitleText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,20"
                                       Text="Configure how background autonomous agents execute tasks, safety approval policies, and desktop notifications." />

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="SAFETY &amp; APPROVAL POLICY" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,10"
                                               Text="Decide when Metis should pause and ask for your approval before running actions." />

                                    <ComboBox x:Name="AgentAutonomyModeBox" Width="380" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Ask Approval for High-Risk Actions (Recommended)" Tag="AskApproval" />
                                        <ComboBoxItem Content="Require Approval for All Actions (Strict)" Tag="Strict" />
                                        <ComboBoxItem Content="Full Autonomy (Auto-Approve Low &amp; Medium Risk)" Tag="FullAutonomy" />
                                    </ComboBox>

                                    <Border Style="{StaticResource Separator}" />
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="DESKTOP NOTIFICATIONS" />
                                    <CheckBox x:Name="AgentNotificationsCheck" Content="Send Windows Desktop Toast Notifications on agent start, approval, finish, and error"
                                              Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="EXECUTION LIMITS &amp; RESILIENCE" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,14"
                                               Text="Fine-tune execution depth for heavy multi-step autonomous tasks." />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Max Turns per Task" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="Maximum reasoning steps an agent can execute before finalizing." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="AgentMaxTurnsSlider" Width="140" Minimum="10" Maximum="100" Value="30" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" />
                                            <TextBlock x:Name="AgentMaxTurnsLabel" Text="30 turns" Width="60" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource Separator}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Tool Timeout (Seconds)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Style="{StaticResource CaptionText}" Text="Maximum execution time before a background command/process times out." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="AgentTimeoutSlider" Width="140" Minimum="10" Maximum="180" Value="45" SmallChange="5" LargeChange="15" IsSnapToTickEnabled="True" TickFrequency="5" />
                                            <TextBlock x:Name="AgentTimeoutLabel" Text="45s" Width="60" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource UtilityCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MonoLabelText}" Text="EMERGENCY STOP" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,12"
                                               Text="You can press F12 at any time to instantly kill all running background agent processes and workers." />
                                    <Button Content="Stop All Active Agents Now (F12)" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Click="StopAllAgents_OnClick" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}"
                    CornerRadius="0,0,12,12" Padding="18,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SaveStatus" Style="{StaticResource CaptionText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,0"
                                   Text="Metis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Open Metis" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="OpenAssistant_OnClick" />
                        <Button x:Name="SaveButton" Content="Save" MinWidth="110" Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
