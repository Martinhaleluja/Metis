<UserControl x:Class="Metis.App.Windows.NotchSpawnAgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640" Background="Transparent"
             Focusable="False">
    <UserControl.Resources>

        <Style x:Key="PresetChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NotchBubbleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NotchFieldEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NotchHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource NotchBubbleBrush}"
            BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
            BorderThickness="1" CornerRadius="14" Margin="0,4,0,10" Padding="18,14">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Spawn Background Agent" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource NotchTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource NotchHoverBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="Close_OnClick" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource NotchMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Description -->
            <TextBlock Text="The agent executes multi-step tasks in the background autonomously without interrupting your mouse or keyboard."
                       FontSize="11" Foreground="{DynamicResource NotchMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- Preset Templates -->
            <TextBlock Text="QUICK PRESETS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource NotchFaintBrush}"
                       Margin="0,0,0,6" />
            <WrapPanel Margin="0,0,0,8">
                <Border Style="{StaticResource PresetChip}" Tag="organize_downloads" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="📁 Organize Downloads" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="web_research" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="🌐 Web Research &amp; Report" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="system_logs" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="💻 System Logs Audit" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="find_extract" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="🔍 Find &amp; Extract Data" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                </Border>
            </WrapPanel>

            <!-- Goal Input -->
            <TextBlock Text="TASK GOAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource NotchFaintBrush}"
                       Margin="0,0,0,4" />
            <Border Background="{DynamicResource NotchFieldBrush}"
                    BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <TextBlock x:Name="GoalPlaceholder"
                               Text="Describe what you want the agent to accomplish..."
                               FontSize="11.5" Foreground="{DynamicResource NotchFaintBrush}"
                               IsHitTestVisible="False" VerticalAlignment="Top" />
                    <TextBox x:Name="GoalBox" Background="Transparent" Foreground="{DynamicResource NotchTextBrush}"
                             BorderThickness="0" FontSize="11.5" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="44" MaxHeight="80"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Disabled"
                             TextChanged="GoalBox_OnTextChanged"
                             KeyDown="GoalBox_OnKeyDown" />
                </Grid>
            </Border>

            <!-- Working Directory -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WORKING DIRECTORY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource NotchFaintBrush}" />
                    <TextBox x:Name="WorkingDirBox" Background="{DynamicResource NotchFieldBrush}"
                             Foreground="{DynamicResource NotchTextBrush}" BorderBrush="{DynamicResource NotchFieldEdgeBrush}"
                             BorderThickness="1" Padding="8,5" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource NotchBubbleBrush}"
                        BorderBrush="{DynamicResource NotchFieldEdgeBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="BrowseDir_OnClick">
                    <TextBlock Text="Browse…" FontSize="11" Foreground="{DynamicResource NotchTextBrush}" />
                </Border>
            </Grid>

            <!-- Footer Action Buttons -->
            <Grid>
                <TextBlock Text="Enter to launch  ·  Shift+Enter for a new line  ·  Esc closes" FontSize="10" Foreground="{DynamicResource NotchFaintBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="Transparent" Padding="12,7" CornerRadius="7" Margin="0,0,8,0"
                            Cursor="Hand" MouseLeftButtonUp="Close_OnClick">
                        <TextBlock Text="Cancel" FontSize="11.5" Foreground="{DynamicResource NotchMutedBrush}" />
                    </Border>
                    <Border x:Name="SpawnButton" Background="{DynamicResource AccentBrush}"
                            Padding="16,7" CornerRadius="7" Cursor="Hand"
                            MouseLeftButtonUp="Spawn_OnClick">
                        <TextBlock Text="⚡ Spawn Agent" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
