<UserControl x:Class="Metis.App.Windows.NotchSpawnAgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Background="Transparent"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1C1C1E" />
        <SolidColorBrush x:Key="PanelCardBg" Color="#26262A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PanelInk" Color="#F2F2F7" />
        <SolidColorBrush x:Key="PanelMuted" Color="#98989D" />
        <SolidColorBrush x:Key="PanelFaint" Color="#636366" />
        <SolidColorBrush x:Key="PanelAccent" Color="#0A7CFF" />
        <SolidColorBrush x:Key="PanelAccentHover" Color="#0066D6" />

        <Style x:Key="PresetChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelCardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38383D" />
                    <Setter Property="BorderBrush" Value="{StaticResource PanelAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Padding="18,16">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="{StaticResource PanelAccent}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Spawn Background Agent" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource PanelInk}" VerticalAlignment="Center" />
                </StackPanel>

                <Border Width="22" Height="22" CornerRadius="11" Background="#1FFFFFFF"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="Close_OnClick" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource PanelMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Description -->
            <TextBlock Text="The agent executes multi-step tasks in the background autonomously without interrupting your mouse or keyboard."
                       FontSize="11" Foreground="{StaticResource PanelMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <!-- Preset Templates -->
            <TextBlock Text="QUICK PRESETS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PanelFaint}"
                       Margin="0,0,0,6" />
            <WrapPanel Margin="0,0,0,10">
                <Border Style="{StaticResource PresetChip}" Tag="organize_downloads" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="📁 Organize Downloads" FontSize="11" Foreground="{StaticResource PanelInk}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="web_research" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="🌐 Web Research &amp; Report" FontSize="11" Foreground="{StaticResource PanelInk}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="system_logs" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="💻 System Logs Audit" FontSize="11" Foreground="{StaticResource PanelInk}" />
                </Border>
                <Border Style="{StaticResource PresetChip}" Tag="find_extract" MouseLeftButtonUp="Preset_OnClick">
                    <TextBlock Text="🔍 Find &amp; Extract Data" FontSize="11" Foreground="{StaticResource PanelInk}" />
                </Border>
            </WrapPanel>

            <!-- Goal Input -->
            <TextBlock Text="TASK GOAL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PanelFaint}"
                       Margin="0,0,0,6" />
            <Border Background="{StaticResource PanelCardBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <Grid>
                    <TextBlock x:Name="GoalPlaceholder"
                               Text="Describe what you want the agent to accomplish..."
                               FontSize="12" Foreground="{StaticResource PanelFaint}"
                               IsHitTestVisible="False" VerticalAlignment="Top" />
                    <TextBox x:Name="GoalBox" Background="Transparent" Foreground="{StaticResource PanelInk}"
                             BorderThickness="0" FontSize="12" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="GoalBox_OnTextChanged"
                             KeyDown="GoalBox_OnKeyDown" />
                </Grid>
            </Border>

            <!-- Working Directory -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WORKING DIRECTORY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PanelFaint}" />
                    <TextBox x:Name="WorkingDirBox" Background="{StaticResource PanelCardBg}"
                             Foreground="{StaticResource PanelInk}" BorderBrush="{StaticResource PanelBorder}"
                             BorderThickness="1" Padding="8,5" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelCardBg}"
                        BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="BrowseDir_OnClick">
                    <TextBlock Text="Browse…" FontSize="11" Foreground="{StaticResource PanelInk}" />
                </Border>
            </Grid>

            <!-- Footer Action Buttons -->
            <Grid>
                <TextBlock Text="Enter to launch  ·  Shift+Enter for a new line  ·  Esc closes" FontSize="10" Foreground="{StaticResource PanelFaint}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="Transparent" Padding="12,7" CornerRadius="7" Margin="0,0,8,0"
                            Cursor="Hand" MouseLeftButtonUp="Close_OnClick">
                        <TextBlock Text="Cancel" FontSize="11.5" Foreground="{StaticResource PanelMuted}" />
                    </Border>
                    <Border x:Name="SpawnButton" Background="{StaticResource PanelAccent}"
                            Padding="16,7" CornerRadius="7" Cursor="Hand"
                            MouseLeftButtonUp="Spawn_OnClick">
                        <TextBlock Text="⚡ Spawn Agent" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
