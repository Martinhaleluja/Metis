<Application x:Class="Metis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Index 0 is the theme swap slot and nothing else may be inserted
                before it: ThemeService replaces this exact entry to switch
                between light, dark, and high contrast at runtime. Controls.xaml
                reaches these tokens through DynamicResource, so replacing the
                dictionary re-resolves every brush in place without reloading a
                window.

                Light is seeded here only so the designer and a crashed startup
                still render; ThemeService overwrites it during OnStartup from
                the saved ThemePreference and the current Windows theme.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Metis;component/Theme/Tokens.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Metis;component/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
