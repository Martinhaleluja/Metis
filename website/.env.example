# The Supabase project behind the waitlist, sign-in, and the account page.
#
# Both of these are browser-safe by design. The publishable key identifies the
# project and grants nothing on its own: row level security decides what any
# request may actually read, and it is already public, because every visitor to
# this site downloads it. The service role key, which does bypass row level
# security, belongs only in the gateway's environment and never here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The Metis AI gateway. Only the account page calls it, and only to manage
# bring-your-own-provider connections — everything else the site needs it asks
# Supabase for directly. Leave it blank and that one section says so rather than
# failing.
VITE_METIS_API_URL=https://metis-api-staging.onrender.com
