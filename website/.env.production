# Build-time configuration for the deployed site.
#
# Both Supabase values are public by design. The publishable key identifies the
# project and grants nothing on its own -- row level security decides what any
# request may read, and every visitor downloads this key anyway. The same pair
# is already compiled into the desktop application in MetisBackend.cs.
#
# They live here, committed, rather than in a dashboard because Vite inlines
# VITE_* at build time: a value that is only set in Vercel's settings is a value
# that silently becomes `undefined` the first time somebody builds from a fresh
# checkout. That is exactly how this site shipped with no working sign-up.
#
# The service role key is the one that must never appear here. It belongs only
# in the gateway's own environment.
VITE_SUPABASE_URL=https://liaqpxhgxmdjzwxullag.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_d9bpXhE-_S1nPKtNfl9X8A_Y8__55u-

# The Metis AI gateway. Only the account page calls it.
VITE_METIS_API_URL=https://metis-gateway.onrender.com
